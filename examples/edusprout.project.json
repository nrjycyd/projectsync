{
  "_formatStatus": "设计草稿，SiteLift 应用不支持导入此嵌套格式。",
  "name": "EduSprout",
  "targetRepo": "D:\\文档\\github_code\\wilson1202\\edusprout",
  "git": {
    "remote": "origin",
    "branch": "main",
    "sshExecutable": "C:\\Windows\\System32\\OpenSSH\\ssh.exe",
    "sshArguments": [
      "-o",
      "BatchMode=yes"
    ]
  },
  "source": {
    "type": "wsl",
    "distribution": "Ubuntu1",
    "user": "ub001",
    "repo": "/home/ub001/edusprout",
    "pullPaths": [
      "docs/notices"
    ]
  },
  "build": {
    "command": "pnpm docs:build",
    "environment": {
      "PATH": "/home/ub001/.nvm/versions/node/v24.21.0/bin:$PATH",
      "CI": "1",
      "NO_COLOR": "1"
    }
  },
  "sync": {
    "include": [
      "README.md",
      "docs",
      "scripts",
      ".github",
      ".gitignore",
      ".pages.yml",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json"
    ],
    "exclude": [
      "docs/.vitepress/dist",
      "docs/.vitepress/cache"
    ],
    "propagateDeletions": true,
    "cleanup": "repositoryUntracked"
  }
}

<ui:FluentWindow x:Class="SiteLift.App.Views.ContentIngestWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="智能归档文档" Width="780" Height="710" MinWidth="620" MinHeight="560"
 ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource ApplicationBackgroundBrush}"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" FontFamily="{StaticResource WorkspaceTypeface}"
 TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Fixed"
 Icon="/SiteLift.App;component/Assets/SiteLift.ico" UseLayoutRounding="True">

 <DockPanel Background="Transparent">
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="智能归档文档">
   <ui:TitleBar.Icon>
    <ui:ImageIcon Source="/SiteLift.App;component/Assets/SiteLift.ico"/>
   </ui:TitleBar.Icon>
  </ui:TitleBar>

  <DockPanel Margin="24,14,24,16" Background="Transparent">
   <!-- Footer Action Bar -->
   <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,10,0,0"
           BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:Button x:Name="CancelButton" Style="{StaticResource WorkspaceTextButton}" Content="取消" Click="CancelClick" Margin="0,0,8,0"/>
      <ui:Button x:Name="ArchiveOnlyButton" Style="{StaticResource WorkspaceIconButton}" Content="仅归档" Appearance="Secondary" Click="ArchiveOnlyClick" Margin="0,0,8,0">
       <ui:Button.Icon>
        <ui:SymbolIcon Symbol="Save16" Style="{StaticResource WorkspaceActionIcon}"/>
       </ui:Button.Icon>
      </ui:Button>
      <ui:Button x:Name="ArchiveAndBuildButton" Style="{StaticResource WorkspaceIconButton}" Content="归档并构建" Appearance="Primary" Click="ArchiveAndBuildClick">
       <ui:Button.Icon>
        <ui:SymbolIcon Symbol="Box16" Style="{StaticResource WorkspaceActionIcon}"/>
       </ui:Button.Icon>
      </ui:Button>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <ui:ProgressRing x:Name="BusyProgressRing" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="FooterHintText" Style="{StaticResource SettingsCardSubtitle}" VerticalAlignment="Center"
                 Text="按 UTF-8 (无 BOM) + LF 写入目标站点，不会修改或删除原始文档。"/>
     </StackPanel>
    </DockPanel>
   </Border>

   <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ui:InfoBar x:Name="IngestStatusBar" IsOpen="False" IsClosable="True" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   </ScrollViewer>

   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <!-- Source Document Card -->
     <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
      <StackPanel>
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
         <ui:ProgressRing x:Name="AiProgressRing" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center"/>
         <ui:Badge x:Name="RouteModeBadge" Content="本地规则推荐" Appearance="Secondary" Margin="0,0,8,0" VerticalAlignment="Center"/>
         <ui:Button x:Name="ReanalyzeButton" Style="{StaticResource WorkspaceCompactIconButton}" Content="重新分析" Click="ReanalyzeClick" Margin="0,0,6,0" ToolTip="重新基于站点画像分析归档位置">
          <ui:Button.Icon>
           <ui:SymbolIcon Symbol="ArrowClockwise16" Style="{StaticResource WorkspaceCompactActionIcon}"/>
          </ui:Button.Icon>
         </ui:Button>
         <ui:Button x:Name="ConfigureAiButton" Style="{StaticResource WorkspaceCompactIconButton}" Content="AI 设置" Click="OpenAiSettingsClick" ToolTip="配置 OpenAI 兼容接口或本地 Ollama">
          <ui:Button.Icon>
           <ui:SymbolIcon Symbol="Settings16" Style="{StaticResource WorkspaceCompactActionIcon}"/>
          </ui:Button.Icon>
         </ui:Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource SettingsCardHeaderIcon}"/>
         <StackPanel>
          <TextBlock x:Name="DocTitleText" Text="待归档文档" Style="{StaticResource SettingsCardTitle}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DocSourcePathText" Text="" Style="{StaticResource SettingsCardSubtitle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
         </StackPanel>
        </StackPanel>
       </DockPanel>

       <DockPanel x:Name="MultiFileBar" Visibility="Collapsed" Margin="0,10,0,0">
        <Label x:Name="MultiFileCountText" DockPanel.Dock="Left" Style="{StaticResource SettingsFieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ui:Button x:Name="BatchArchiveAllButton" DockPanel.Dock="Right" Style="{StaticResource WorkspaceCompactIconButton}"
                   Content="按推荐批量归档全部" Click="BatchArchiveAllClick" Margin="8,0,0,0" VerticalAlignment="Center"
                   ToolTip="按站点画像推荐依次归档剩余文档（自动跳过重名冲突）">
         <ui:Button.Icon>
          <ui:SymbolIcon Symbol="Save16" Style="{StaticResource WorkspaceCompactActionIcon}"/>
         </ui:Button.Icon>
        </ui:Button>
        <ComboBox x:Name="FileSelectorCombo" MinHeight="32" SelectionChanged="FileSelectionChanged"/>
       </DockPanel>
      </StackPanel>
     </Border>

     <!-- Target Routing Card -->
     <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,10">
      <StackPanel>
       <DockPanel Margin="0,0,0,10">
        <ui:Badge x:Name="SiteFrameworkBadge" DockPanel.Dock="Right" Content="" Appearance="Secondary" VerticalAlignment="Center"/>
        <StackPanel>
         <TextBlock Text="归档目标" Style="{StaticResource SettingsCardTitle}"/>
         <TextBlock x:Name="ProfileStatusText" Text="基于 .sitelift/profile.json 站点画像推荐" Style="{StaticResource SettingsCardSubtitle}" Margin="0,2,0,0"/>
        </StackPanel>
       </DockPanel>

       <DockPanel x:Name="StaleProfilePanel" Visibility="Collapsed" Margin="0,0,0,10">
        <ui:Button x:Name="RefreshProfileButton" DockPanel.Dock="Right" Style="{StaticResource WorkspaceCompactIconButton}"
                   Content="刷新画像" Click="RefreshProfileClick" Margin="8,0,0,0" VerticalAlignment="Center">
         <ui:Button.Icon>
          <ui:SymbolIcon Symbol="ArrowClockwise16" Style="{StaticResource WorkspaceCompactActionIcon}"/>
         </ui:Button.Icon>
        </ui:Button>
        <ui:InfoBar x:Name="StaleProfileInfoBar" Severity="Warning" IsOpen="True" IsClosable="False"
                    Message="检测到站点目录结构或配置已变化，建议刷新画像。"/>
       </DockPanel>

       <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="220"/>
         <ColumnDefinition Width="12"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
         <Label Content="目标站点" Target="{Binding ElementName=ProjectSelectorCombo}" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,4"/>
         <ComboBox x:Name="ProjectSelectorCombo" MinHeight="34" DisplayMemberPath="Name" SelectionChanged="ProjectSelectionChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <Label Content="目标目录（仅列出站点画像中的安全内容目录）" Target="{Binding ElementName=TargetDirCombo}" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,4"/>
         <ComboBox x:Name="TargetDirCombo" MinHeight="34" DisplayMemberPath="DisplayText" SelectionChanged="TargetSelectionChanged"/>
        </StackPanel>
       </Grid>

       <TextBlock x:Name="RouteReasonText" Style="{StaticResource SettingsCardSubtitle}" TextWrapping="Wrap" Margin="0,0,0,8"/>

       <StackPanel x:Name="RememberHintPanel" Visibility="Collapsed" Margin="0,0,0,10">
        <CheckBox x:Name="RememberHintCheck" Content="记住此目录偏好（自动追加到 .sitelift/profile.json 的 userRules）" Margin="0,0,0,4"/>
        <ui:TextBox x:Name="RoutingHintBox" MinHeight="32" ClearButtonEnabled="True"
                    PlaceholderText="例如：关于 AI 的文章放入 docs/ai"/>
       </StackPanel>

       <Label Content="目标文件名" Target="{Binding ElementName=TargetFileNameBox}" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,4"/>
       <ui:TextBox x:Name="TargetFileNameBox" MinHeight="34" ClearButtonEnabled="True" TextChanged="TargetFileNameChanged"/>

       <TextBlock x:Name="TargetFullPreviewText" Style="{StaticResource SettingsCardSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0"/>

       <StackPanel x:Name="OverwriteWarningPanel" Visibility="Collapsed" Margin="0,8,0,0">
        <ui:InfoBar x:Name="OverwriteInfoBar" Severity="Warning" IsOpen="True" IsClosable="False"
                    Message="目标路径已存在同名文章，归档将覆盖原文件。"/>
        <CheckBox x:Name="AllowOverwriteCheck" Content="确认覆盖已有文章" Margin="2,6,0,0" Checked="OverwriteCheckChanged" Unchecked="OverwriteCheckChanged"/>
       </StackPanel>

       <StackPanel x:Name="NavigationPatchPanel" Visibility="Collapsed" Margin="0,8,0,0">
        <CheckBox x:Name="ApplyNavPatchCheck" Content="同步追加导航条目" IsChecked="True" Margin="0,0,0,4"/>
        <ui:TextBox x:Name="NavigationPatchPreviewBox" Style="{StaticResource WorkspaceMonoInput}"
                    IsReadOnly="True" AcceptsReturn="True" Height="64"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
       </StackPanel>

       <DockPanel x:Name="NavigationAdvicePanel" Visibility="Collapsed" Margin="0,8,0,0">
        <ui:Button DockPanel.Dock="Right" Style="{StaticResource WorkspaceCompactIconButton}" Content="复制提示" Click="CopyNavAdviceClick" Margin="8,0,0,0" VerticalAlignment="Center">
         <ui:Button.Icon>
          <ui:SymbolIcon Symbol="Copy16" Style="{StaticResource WorkspaceCompactActionIcon}"/>
         </ui:Button.Icon>
        </ui:Button>
        <ui:InfoBar x:Name="NavigationInfoBar" Severity="Informational" IsOpen="True" IsClosable="False"/>
       </DockPanel>
      </StackPanel>
     </Border>

     <!-- Frontmatter & Assets Card -->
     <Border Style="{StaticResource SettingsCard}" Margin="0">
      <StackPanel>
       <DockPanel Margin="0,0,0,6">
        <TextBlock x:Name="FrontmatterHintText" DockPanel.Dock="Right" Style="{StaticResource SettingsCardSubtitle}" VerticalAlignment="Center"/>
        <CheckBox x:Name="ApplyFrontmatterCheck" Content="写入 / 更新 Frontmatter 头部" VerticalAlignment="Center"
                  Checked="FrontmatterCheckChanged" Unchecked="FrontmatterCheckChanged"/>
       </DockPanel>
       <ui:TextBox x:Name="FrontmatterEditor" Style="{StaticResource WorkspaceMonoInput}"
                   AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Height="116" Margin="0,0,0,10"/>

       <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,10"/>

       <DockPanel Margin="0,0,0,6">
        <TextBlock x:Name="AssetsSummaryText" DockPanel.Dock="Right" Style="{StaticResource SettingsCardSubtitle}" VerticalAlignment="Center"/>
        <CheckBox x:Name="CopyAssetsCheck" Content="随行复制本地图片并重写 Markdown 链接" IsChecked="True" VerticalAlignment="Center"/>
       </DockPanel>
       <ItemsControl x:Name="AssetsList" Margin="2,2,0,0">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <DockPanel Margin="0,2">
           <TextBlock DockPanel.Dock="Right" Text="{Binding LinkPreview}" Style="{StaticResource SettingsCardSubtitle}" Margin="10,0,0,0"/>
           <TextBlock Text="{Binding RoutePreview}" FontSize="12" FontFamily="{StaticResource WorkspaceMonoTypeface}"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock x:Name="MissingAssetsWarningText" Style="{StaticResource SettingsCardSubtitle}"
                  Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                  Visibility="Collapsed" Margin="2,4,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>
 </DockPanel>
</ui:FluentWindow>

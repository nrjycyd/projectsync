<ui:FluentWindow x:Class="SiteLift.App.Views.WslManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SiteLift.App.Views"
 Title="WSL 环境管理" Width="1140" Height="580" MinWidth="760" MinHeight="440"
 ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}" FontSize="14"
 FontFamily="{StaticResource WorkspaceTypeface}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
 TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Fixed"
 Icon="/SiteLift.App;component/Assets/SiteLift.ico" UseLayoutRounding="True">

 <ui:FluentWindow.Resources>
  <Thickness x:Key="InstanceCellInset">10,0</Thickness>
  <Style x:Key="InstanceColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceColumnHeader}">
   <Setter Property="Padding" Value="{StaticResource InstanceCellInset}"/>
  </Style>
  <Style x:Key="InstanceTextCell" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceTableText}">
   <Setter Property="Margin" Value="{StaticResource InstanceCellInset}"/>
  </Style>
 </ui:FluentWindow.Resources>
 <DockPanel Background="Transparent">
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="WSL 环境管理">
   <ui:TitleBar.Icon>
    <ui:ImageIcon Source="/SiteLift.App;component/Assets/SiteLift.ico"/>
   </ui:TitleBar.Icon>
  </ui:TitleBar>
  <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
   <DockPanel Margin="24,14,24,16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
     <StackPanel x:Name="Toolbar" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
      <ui:Button Style="{StaticResource WorkspaceIconButton}" Content="刷新检测" Margin="0,0,8,0" Click="RefreshClick">
       <ui:Button.Icon>
        <ui:SymbolIcon Symbol="ArrowClockwise16" Style="{StaticResource WorkspaceActionIcon}"/>
       </ui:Button.Icon>
      </ui:Button>
      <ui:Button x:Name="InstallDistributionButton" Style="{StaticResource WorkspaceIconButton}" Content="安装发行版" Appearance="Secondary" Margin="0,0,8,0" IsEnabled="False" Click="InstallClick">
       <ui:Button.Icon>
        <ui:SymbolIcon Symbol="Add16" Style="{StaticResource WorkspaceActionIcon}"/>
       </ui:Button.Icon>
      </ui:Button>
      <ui:Button x:Name="UpdateWslButton" Style="{StaticResource WorkspaceIconButton}" Content="更新 WSL" IsEnabled="False" Click="UpdateClick">
       <ui:Button.Icon>
        <ui:SymbolIcon Symbol="ArrowUpload16" Style="{StaticResource WorkspaceActionIcon}"/>
       </ui:Button.Icon>
      </ui:Button>
      <ui:Button x:Name="WslSetupButton" Style="{StaticResource WorkspaceTextButton}" Content="WSL 安装与修复" Appearance="Primary" Visibility="Collapsed" Click="SetupWslClick"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <ui:SymbolIcon Symbol="Desktop24" FontSize="22" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
      <TextBlock Text="WSL 发行版" Style="{StaticResource SettingsPageTitle}" Margin="0" VerticalAlignment="Center"/>
      <ui:Badge x:Name="VersionBadge" Appearance="Secondary" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0"/>
      <ui:Badge x:Name="InstanceCountBadge" Appearance="Info" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0,0,0"/>
      <ui:ProgressRing x:Name="WslBusyRing" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0"/>
     </StackPanel>
    </DockPanel>

    <ScrollViewer DockPanel.Dock="Top" MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ui:InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
    </ScrollViewer>

    <ui:CardExpander x:Name="LogArea" DockPanel.Dock="Bottom" Margin="0,12,0,0" Icon="{ui:SymbolIcon WindowConsole20}">
     <ui:CardExpander.Header>
      <StackPanel>
       <TextBlock Text="运行日志" Style="{StaticResource SettingsCardTitle}"/>
       <TextBlock Text="查看 WSL 安装、更新、导出及磁盘上限调整的实时输出" Style="{StaticResource SettingsCardSubtitle}" Margin="0,2,0,0"/>
      </StackPanel>
     </ui:CardExpander.Header>
     <ui:TextBox x:Name="Log" Style="{StaticResource WorkspaceLog}" Height="112" Padding="12,8"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </ui:CardExpander>

    <Grid>
     <Border x:Name="InstanceFrame" SnapsToDevicePixels="True" Style="{StaticResource SettingsCard}" Margin="0" Padding="0">
      <ui:DataGrid x:Name="Instances" ColumnHeaderStyle="{StaticResource InstanceColumnHeader}" SizeChanged="InstanceGridSizeChanged" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                   HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                   RowHeight="46" ColumnHeaderHeight="38" BorderThickness="0" Background="Transparent">
       <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
         <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
         <Setter Property="Background" Value="Transparent"/>
         <Style.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
         </Style.Triggers>
        </Style>
       </DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="实例名称" Width="*" MinWidth="112" MaxWidth="190">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <DockPanel Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center">
           <ui:Badge DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Content="默认" Appearance="Success">
            <ui:Badge.Style>
             <Style TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True">
               <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger></Style.Triggers>
             </Style>
            </ui:Badge.Style>
           </ui:Badge>
           <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="Normal" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="发行版" Width="120">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <DockPanel Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center" Background="Transparent"
                     ToolTip="{Binding DistributionHint}" AutomationProperties.Name="{Binding DistributionHint}">
           <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
            <Image Source="{Binding DistributionIcon}" Stretch="Uniform"/>
            <ui:SymbolIcon Symbol="Desktop24" FontSize="16">
             <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding DistributionIcon}" Value="{x:Null}">
                 <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                 <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
           </Grid>
           <TextBlock Text="{Binding Distribution}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="WSL" Binding="{Binding Version}" Width="66" ElementStyle="{StaticResource InstanceTextCell}"/>
        <DataGridTextColumn Header="安装位置" Binding="{Binding Location}" Width="1.55*" MinWidth="88" MaxWidth="260"
                            ElementStyle="{StaticResource WorkspaceTableSecondaryText}"/>
        <DataGridTemplateColumn Header="磁盘容量" Width="1.1*" MinWidth="112" MaxWidth="176">
         <DataGridTemplateColumn.HeaderStyle>
          <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource InstanceColumnHeader}">
           <Setter Property="HorizontalContentAlignment" Value="Right"/>
          </Style>
         </DataGridTemplateColumn.HeaderStyle>
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Margin="{StaticResource InstanceCellInset}" Background="Transparent" VerticalAlignment="Center" ToolTip="{Binding Disk.Hint}"
                      AutomationProperties.Name="{Binding Disk.Hint}">
           <TextBlock Text="{Binding Disk.Label}" FontFamily="{StaticResource WorkspaceSmallTypeface}" FontSize="12"
                      LineHeight="16" LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular"
                      TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
           <ProgressBar Value="{Binding Disk.Percent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,4,0,0"
                        AutomationProperties.Name="剩余空间比例">
            <ProgressBar.Style>
             <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
              <Style.Triggers>
               <DataTrigger Binding="{Binding Disk.HasMeasurement}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
               <DataTrigger Binding="{Binding Disk.IsLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
              </Style.Triggers>
             </Style>
            </ProgressBar.Style>
           </ProgressBar>
          </StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="开发环境" Width="1.05*" MinWidth="96" MaxWidth="160">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Grid Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center">
           <TextBlock Text="{Binding ToolStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"
                      VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolStatus}"/>
           <ItemsControl ItemsSource="{Binding Tools}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
             <Border Background="Transparent" Height="24" ToolTip="{Binding Caption}"
                     AutomationProperties.Name="{Binding Caption}">
              <Image Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
               <Image.Style>
                <Style TargetType="Image">
                 <Setter Property="Source" Value="{Binding Icon}"/>
                 <Style.Triggers>
                  <MultiDataTrigger>
                   <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tool}" Value="pnpm"/>
                    <Condition Binding="{Binding Foreground.Color, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="White"/>
                   </MultiDataTrigger.Conditions>
                   <Setter Property="Source" Value="/SiteLift.App;component/Assets/DevelopmentTools/pnpm-dark.png"/>
                  </MultiDataTrigger>
                 </Style.Triggers>
                </Style>
               </Image.Style>
              </Image>
             </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
          </Grid>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="操作" Width="1.5*" MinWidth="154" MaxWidth="216">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Grid Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
           <ui:Button Style="{StaticResource WorkspaceCompactIconButton}" Height="30" HorizontalAlignment="Stretch" Content="终端" ToolTip="启动终端" AutomationProperties.Name="启动终端" Padding="6,3.5,8,4.5" Click="LaunchClick" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ui:Button.Icon>
             <ui:SymbolIcon Symbol="WindowConsole20" Style="{StaticResource WorkspaceCompactActionIcon}"/>
            </ui:Button.Icon>
           </ui:Button>
           <ui:DropDownButton Grid.Column="2" Style="{StaticResource WorkspaceCompactDropDownButton}" Height="30" HorizontalAlignment="Stretch" Content="更多" Appearance="Secondary" PreviewKeyDown="MenuKeyDown">
            <ui:DropDownButton.Flyout>
             <local:RightAlignedContextMenu Style="{StaticResource {x:Type ContextMenu}}"
                                            DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <ui:MenuItem Header="配置开发环境" Click="ConfigureDevelopmentClick">
               <ui:MenuItem.Icon><ui:SymbolIcon Symbol="Wrench16" Style="{StaticResource WorkspaceMenuIcon}"/></ui:MenuItem.Icon>
              </ui:MenuItem>
              <ui:MenuItem Header="设为默认" Click="DefaultClick">
               <ui:MenuItem.Icon><ui:SymbolIcon Symbol="Checkmark16" Style="{StaticResource WorkspaceMenuIcon}"/></ui:MenuItem.Icon>
              </ui:MenuItem>
              <ui:MenuItem Header="调整磁盘上限" Click="ResizeClick">
               <ui:MenuItem.Icon><ui:SymbolIcon Symbol="Settings16" Style="{StaticResource WorkspaceMenuIcon}"/></ui:MenuItem.Icon>
              </ui:MenuItem>
              <ui:MenuItem Header="导出备份" Click="ExportClick">
               <ui:MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen16" Style="{StaticResource WorkspaceMenuIcon}"/></ui:MenuItem.Icon>
              </ui:MenuItem>
              <Separator/>
              <ui:MenuItem Header="注销并删除" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Click="DeleteClick">
               <ui:MenuItem.Icon>
                <ui:SymbolIcon Symbol="Delete16" Style="{StaticResource WorkspaceMenuIcon}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
               </ui:MenuItem.Icon>
              </ui:MenuItem>
             </local:RightAlignedContextMenu>
            </ui:DropDownButton.Flyout>
           </ui:DropDownButton>
          </Grid>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </ui:DataGrid>
     </Border>
     <StackPanel x:Name="EmptyInstancesHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,24,24,0" Visibility="Collapsed" IsHitTestVisible="False">
      <ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource WorkspaceEmptyIcon}"/>
      <TextBlock Text="尚未安装 WSL 发行版" Style="{StaticResource WorkspaceEmptyTitle}"/>
      <TextBlock Text="点击右上角「安装发行版」开始安装。" Style="{StaticResource WorkspaceEmptySubtitle}"/>
     </StackPanel>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</ui:FluentWindow>

<ui:FluentWindow x:Class="SiteLift.App.Views.AiSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AI 助手设置" Width="560" Height="500" MinWidth="480" MinHeight="460"
 ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource ApplicationBackgroundBrush}"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" FontFamily="{StaticResource WorkspaceTypeface}"
 TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Fixed"
 Icon="/SiteLift.App;component/Assets/SiteLift.ico" UseLayoutRounding="True">

 <DockPanel Background="Transparent">
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="AI 助手设置">
   <ui:TitleBar.Icon>
    <ui:ImageIcon Source="/SiteLift.App;component/Assets/SiteLift.ico"/>
   </ui:TitleBar.Icon>
  </ui:TitleBar>
  <DockPanel Margin="24,14,24,16" Background="Transparent">
   <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,10,0,0"
           BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:Button x:Name="CancelButton" Style="{StaticResource WorkspaceTextButton}" Content="取消" Click="CancelClick" Margin="0,0,8,0"/>
      <ui:Button x:Name="SaveButton" Style="{StaticResource WorkspaceIconButton}" Content="保存设置" Appearance="Primary" Click="SaveClick">
       <ui:Button.Icon>
        <ui:SymbolIcon Symbol="Save16" Style="{StaticResource WorkspaceActionIcon}"/>
       </ui:Button.Icon>
      </ui:Button>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <ui:Button x:Name="TestButton" Style="{StaticResource WorkspaceIconButton}" Content="测试连接" Appearance="Secondary" Click="TestClick">
       <ui:Button.Icon>
        <ui:SymbolIcon Symbol="PlugConnected20" Style="{StaticResource WorkspaceActionIcon}"/>
       </ui:Button.Icon>
      </ui:Button>
      <ui:ProgressRing x:Name="TestProgressRing" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </DockPanel>
   </Border>

   <ui:InfoBar DockPanel.Dock="Bottom" x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>

   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Style="{StaticResource SettingsCard}" Margin="0">
     <StackPanel>
      <DockPanel Margin="0,0,0,12">
       <ui:ToggleSwitch x:Name="AiEnabledSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                        OnContent="已启用" OffContent="未启用"/>
       <StackPanel>
        <TextBlock Text="OpenAI 兼容接口（可选）" Style="{StaticResource SettingsCardTitle}"/>
        <TextBlock Text="未启用或未配置时，拖入归档将自动使用本地画像规则；启用后仅发送画像摘要与文章前段。"
                   Style="{StaticResource SettingsCardSubtitle}" TextWrapping="Wrap" Margin="0,2,12,0"/>
       </StackPanel>
      </DockPanel>

      <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,0,0,12"/>

      <Label Content="快捷填充预设" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,6"/>
      <WrapPanel Margin="0,0,0,12">
       <ui:Button Style="{StaticResource WorkspaceCompactIconButton}" Content="DeepSeek" Tag="deepseek" Click="ApplyPresetClick" Margin="0,0,8,4"/>
       <ui:Button Style="{StaticResource WorkspaceCompactIconButton}" Content="OpenAI" Tag="openai" Click="ApplyPresetClick" Margin="0,0,8,4"/>
       <ui:Button Style="{StaticResource WorkspaceCompactIconButton}" Content="Gemini" Tag="gemini" Click="ApplyPresetClick" Margin="0,0,8,4"/>
       <ui:Button Style="{StaticResource WorkspaceCompactIconButton}" Content="本地 Ollama" Tag="ollama" Click="ApplyPresetClick" Margin="0,0,0,4"/>
      </WrapPanel>

      <Label Content="接口地址（Base URL 或 /chat/completions）" Target="{Binding ElementName=EndpointBox}" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,4"/>
      <ui:TextBox x:Name="EndpointBox" MinHeight="34" ClearButtonEnabled="True" Margin="0,0,0,10"
                  PlaceholderText="例如 https://api.deepseek.com/v1"/>

      <Label Content="模型名称" Target="{Binding ElementName=ModelBox}" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,4"/>
      <ui:TextBox x:Name="ModelBox" MinHeight="34" ClearButtonEnabled="True" Margin="0,0,0,10"
                  PlaceholderText="例如 deepseek-chat / gpt-4o-mini / qwen2.5:14b"/>

      <DockPanel Margin="0,0,0,4">
       <ui:Button x:Name="ClearKeyButton" DockPanel.Dock="Right" Style="{StaticResource WorkspaceCompactIconButton}"
                  Content="清除已存密钥" Click="ClearKeyClick" Visibility="Collapsed" VerticalAlignment="Center"/>
       <Label Content="API Key（使用 Windows DPAPI 加密存储在本地，本地 Ollama 可留空）"
              Target="{Binding ElementName=ApiKeyBox}" Style="{StaticResource SettingsFieldLabel}" VerticalAlignment="Center"/>
      </DockPanel>
      <ui:PasswordBox x:Name="ApiKeyBox" MinHeight="34" Margin="0,0,0,6"
                      PlaceholderText="输入 API Key（不会写入项目配置或诊断包）"/>
      <TextBlock x:Name="KeyHintText" Style="{StaticResource SettingsCardSubtitle}" Margin="0,0,0,4"
                 Text="密钥仅以当前 Windows 用户身份加密保存于 %LOCALAPPDATA%\SiteLift\ai-settings.json。"/>
     </StackPanel>
    </Border>
   </ScrollViewer>
  </DockPanel>
 </DockPanel>
</ui:FluentWindow>

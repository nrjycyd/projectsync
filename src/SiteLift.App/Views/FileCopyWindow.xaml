<ui:FluentWindow x:Class="SiteLift.App.Views.FileCopyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:SiteLift.App.Views"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="文件复制" Width="740" Height="660" MinWidth="540" MinHeight="540"
 ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource ApplicationBackgroundBrush}"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" FontFamily="{StaticResource WorkspaceTypeface}"
 TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Fixed"
 Icon="/SiteLift.App;component/Assets/SiteLift.ico" UseLayoutRounding="True">

 <DockPanel Background="Transparent">
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="文件复制">
   <ui:TitleBar.Icon>
    <ui:ImageIcon Source="/SiteLift.App;component/Assets/SiteLift.ico"/>
   </ui:TitleBar.Icon>
  </ui:TitleBar>
  <Grid Background="Transparent">
   <DockPanel Margin="24,14,24,16">
    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="0,10,0,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <ui:Button x:Name="CancelCopy" Style="{StaticResource WorkspaceTextButton}" Content="取消" Click="CancelClick" Visibility="Collapsed" Margin="0,0,8,0"/>
       <ui:Button Style="{StaticResource WorkspaceIconButton}" x:Name="StartCopy" Content="开始复制" Appearance="Secondary" IsEnabled="False" Click="CopyClick">
        <ui:Button.Icon>
         <ui:SymbolIcon Symbol="Copy16" Style="{StaticResource WorkspaceActionIcon}"/>
        </ui:Button.Icon>
       </ui:Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <ui:ProgressRing x:Name="CopyProgressRing" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center"/>
       <TextBlock x:Name="FooterHint" Style="{StaticResource SettingsCardSubtitle}" VerticalAlignment="Center"
                  Text="请先填写路径并预览复制清单，确认无误后再执行复制。"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ui:InfoBar x:Name="CopyStatus" IsOpen="False" IsClosable="True" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
    </ScrollViewer>
    <Grid x:Name="CopyBody" SizeChanged="CopyBodySizeChanged">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <ScrollViewer x:Name="CopyFormScroller" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
       <StackPanel x:Name="CopyOptions">
        <DockPanel Margin="0,0,0,12">
         <ui:Button Style="{StaticResource WorkspaceCompactIconButton}" x:Name="SwapEndpoints" DockPanel.Dock="Right" Content="交换路径" IsEnabled="False" Click="SwapClick"
                    ToolTip="仅在来源和目标均为现有目录时交换"
                    AutomationProperties.Name="交换来源和目标" VerticalAlignment="Center" Margin="12,0,0,0">
          <ui:Button.Icon>
           <ui:SymbolIcon Symbol="ArrowSort16" Style="{StaticResource WorkspaceCompactActionIcon}"/>
          </ui:Button.Icon>
         </ui:Button>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="FolderOpen24" Style="{StaticResource SettingsCardHeaderIcon}"/>
          <StackPanel>
           <TextBlock Text="路径与选项" Style="{StaticResource SettingsCardTitle}"/>
           <TextBlock Text="支持本机 Windows 与 WSL 发行版之间互传；复制目录时会在目标下保留来源目录名" Style="{StaticResource SettingsCardSubtitle}" Margin="0,2,0,0"/>
          </StackPanel>
         </StackPanel>
        </DockPanel>

        <Label Content="来源文件或目录" Target="{Binding ElementName=SourcePath}" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
         <ComboBox x:Name="SourceLocation" DockPanel.Dock="Left" Width="156" MinHeight="34" Margin="0,0,8,0" VerticalAlignment="Stretch"
                   SelectionChanged="EndpointChanged" AutomationProperties.Name="来源位置" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
         <ui:DropDownButton x:Name="BrowseSource" DockPanel.Dock="Right" MinWidth="88" MinHeight="34" Margin="8,0,0,0" VerticalAlignment="Stretch"
                            Content="浏览" AutomationProperties.Name="浏览来源" PreviewKeyDown="BrowseSourceKeyDown">
          <ui:DropDownButton.Flyout>
           <local:RightAlignedContextMenu Style="{StaticResource {x:Type ContextMenu}}">
            <ui:MenuItem Header="选择文件" Click="BrowseSourceFile">
             <ui:MenuItem.Icon><ui:SymbolIcon Symbol="Document16" Style="{StaticResource WorkspaceMenuIcon}"/></ui:MenuItem.Icon>
            </ui:MenuItem>
            <ui:MenuItem Header="选择目录" Click="BrowseSourceFolder">
             <ui:MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen16" Style="{StaticResource WorkspaceMenuIcon}"/></ui:MenuItem.Icon>
            </ui:MenuItem>
           </local:RightAlignedContextMenu>
          </ui:DropDownButton.Flyout>
         </ui:DropDownButton>
         <ui:TextBox x:Name="SourcePath" MinHeight="34" ClearButtonEnabled="True" VerticalAlignment="Stretch" TextChanged="OptionsChanged"/>
        </DockPanel>

        <Label Content="目标目录" Target="{Binding ElementName=TargetPath}" Style="{StaticResource SettingsFieldLabel}" Margin="0,0,0,4"/>
        <DockPanel>
         <ComboBox x:Name="TargetLocation" DockPanel.Dock="Left" Width="156" MinHeight="34" Margin="0,0,8,0" VerticalAlignment="Stretch"
                   SelectionChanged="EndpointChanged" AutomationProperties.Name="目标位置" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
         <ui:Button x:Name="BrowseTarget" Style="{StaticResource WorkspaceTextButton}" DockPanel.Dock="Right" MinWidth="88" Margin="8,0,0,0" VerticalAlignment="Stretch"
                    Content="浏览" AutomationProperties.Name="浏览目标目录" Click="BrowseTargetFolder"/>
         <ui:TextBox x:Name="TargetPath" MinHeight="34" ClearButtonEnabled="True" VerticalAlignment="Stretch" TextChanged="OptionsChanged"/>
        </DockPanel>

        <ui:InfoBar x:Name="PathFeedback" IsOpen="False" IsClosable="True" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>

        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,12,0,10"/>
        <WrapPanel VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <Label Content="同名文件" Target="{Binding ElementName=Conflict}" Style="{StaticResource SettingsFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="Conflict" Width="100" MinHeight="32" SelectedIndex="0" SelectionChanged="OptionsChanged">
           <ComboBoxItem Content="跳过"/>
           <ComboBoxItem Content="覆盖"/>
          </ComboBox>
         </StackPanel>
         <ui:ToggleSwitch x:Name="SkipMarks" OnContent="跳过 Zone.Identifier 下载标记" OffContent="跳过 Zone.Identifier 下载标记" IsChecked="True"
                          Checked="OptionsChanged" Unchecked="OptionsChanged" VerticalAlignment="Center"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </ScrollViewer>

     <Border x:Name="PreviewTableFrame" Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="0" Margin="0">
      <DockPanel>
       <Border DockPanel.Dock="Top" Style="{StaticResource SettingsCardHeader}" Padding="14,10,14,10">
        <DockPanel>
         <ui:Button x:Name="PreviewCopy" Style="{StaticResource WorkspaceIconButton}" DockPanel.Dock="Right"
                    Content="预览复制" Appearance="Primary" IsEnabled="False" Click="PreviewClick" Margin="12,0,0,0">
          <ui:Button.Icon>
           <ui:SymbolIcon Symbol="Eye16" Style="{StaticResource WorkspaceActionIcon}"/>
          </ui:Button.Icon>
         </ui:Button>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource SettingsCardHeaderIcon}"/>
          <TextBlock Text="复制清单" Style="{StaticResource SettingsCardTitle}" VerticalAlignment="Center"/>
          <ui:Badge x:Name="PreviewCountBadge" Appearance="Secondary" Content="未预览" VerticalAlignment="Center" Margin="10,0,0,0"/>
         </StackPanel>
        </DockPanel>
       </Border>
       <Grid>
        <ui:DataGrid x:Name="Changes" ColumnHeaderStyle="{StaticResource WorkspaceColumnHeader}" SizeChanged="ChangesTableSizeChanged"
                     IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                     HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                     BorderThickness="0" Background="Transparent" RowHeight="36" ColumnHeaderHeight="36" AutomationProperties.Name="复制清单">
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="操作" Width="120" SortMemberPath="Action">
           <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
             <ui:Badge HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Content="{Binding Action}">
              <ui:Badge.Style>
               <Style TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
                <Setter Property="Appearance" Value="Secondary"/>
                <Style.Triggers>
                 <DataTrigger Binding="{Binding Action}" Value="复制"><Setter Property="Appearance" Value="Success"/></DataTrigger>
                 <DataTrigger Binding="{Binding Action}" Value="覆盖"><Setter Property="Appearance" Value="Caution"/></DataTrigger>
                 <DataTrigger Binding="{Binding Action}" Value="创建目录"><Setter Property="Appearance" Value="Info"/></DataTrigger>
                </Style.Triggers>
               </Style>
              </ui:Badge.Style>
             </ui:Badge>
            </DataTemplate>
           </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="目标相对路径" Width="*" MinWidth="160" Binding="{Binding Path}" ElementStyle="{StaticResource WorkspaceTableText}"/>
         </DataGrid.Columns>
        </ui:DataGrid>
        <StackPanel x:Name="EmptyPreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,24,24,0" IsHitTestVisible="False">
         <ui:SymbolIcon Symbol="DocumentText24" Style="{StaticResource WorkspaceEmptyIcon}"/>
         <TextBlock Text="暂无待复制清单" Style="{StaticResource WorkspaceEmptyTitle}"/>
         <TextBlock Text="填写来源与目标路径后，点击右上角「预览复制」查看待执行的文件清单。" Style="{StaticResource WorkspaceEmptySubtitle}"/>
        </StackPanel>
       </Grid>
      </DockPanel>
     </Border>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</ui:FluentWindow>

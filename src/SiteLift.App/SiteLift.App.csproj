<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.3.0</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/SiteLift.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/SiteLift.ico" />
    <Resource Include="Assets/DevelopmentTools/*.png" />
    <Content Include="Assets/DevelopmentTools/Notices.md" Link="licenses/DevelopmentToolLogos.md" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../SiteLift.Core/SiteLift.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(PkgWPF-UI)/LICENSE.md" Link="licenses/WPF-UI-LICENSE.md"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgWPF-UI)/ThirdPartyNotices.txt" Link="licenses/WPF-UI-ThirdPartyNotices.txt"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" GeneratePathProperty="true" />
  </ItemGroup>
</Project>

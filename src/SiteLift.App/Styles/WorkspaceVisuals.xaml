 <Style x:Key="WorkspaceRowIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
  <Setter Property="Appearance" Value="Transparent"/>
  <Setter Property="Width" Value="30"/>
  <Setter Property="Height" Value="28"/>
  <Setter Property="Margin" Value="1,0"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceRowIconFocusVisual}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type ui:Button}">
     <Grid Background="Transparent" ClipToBounds="False">
      <Ellipse x:Name="RadialHalo" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsHitTestVisible="False" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0">
       <Ellipse.Effect>
        <BlurEffect Radius="11"/>
       </Ellipse.Effect>
      </Ellipse>
      <Rectangle x:Name="GlyphGlow"
                 Width="{Binding ActualWidth, ElementName=IconHost}"
                 Height="{Binding ActualHeight, ElementName=IconHost}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" Opacity="0">
       <Rectangle.Fill>
        <VisualBrush Visual="{Binding ElementName=IconHost}" Stretch="None"/>
       </Rectangle.Fill>
       <Rectangle.Effect>
        <BlurEffect Radius="5"/>
       </Rectangle.Effect>
      </Rectangle>
      <ContentPresenter x:Name="IconHost" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.68"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
       <Setter TargetName="RadialHalo" Property="Opacity" Value="0.24"/>
       <Setter TargetName="GlyphGlow" Property="Opacity" Value="0.65"/>
       <Setter TargetName="IconHost" Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
       <Setter TargetName="RadialHalo" Property="Opacity" Value="0.14"/>
       <Setter TargetName="GlyphGlow" Property="Opacity" Value="0.38"/>
       <Setter TargetName="IconHost" Property="Opacity" Value="0.86"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="IconHost" Property="Opacity" Value="0.35"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <FontFamily x:Key="WorkspaceTypeface">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
 <FontFamily x:Key="WorkspaceMonoTypeface">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
 <Style x:Key="WorkspaceActionIcon" TargetType="{x:Type ui:SymbolIcon}">
  <Setter Property="Width" Value="18"/>
  <Setter Property="Height" Value="20"/>
  <Setter Property="FontSize" Value="16"/>
  <Setter Property="RenderTransform">
   <Setter.Value>
    <TranslateTransform Y="1.6"/>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="WorkspaceIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
  <Setter Property="MinHeight" Value="34"/>
  <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
 </Style>
 <Style x:Key="WorkspaceCompactIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource WorkspaceIconButton}">
  <Setter Property="MinHeight" Value="30"/>
  <Setter Property="Padding" Value="11,3"/>
 </Style>
 <Style x:Key="WorkspacePanel" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="4"/>
 </Style>
 <Style x:Key="WorkspaceColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultUiDataGridColumnHeaderStyle}">
  <Setter Property="Padding" Value="12,0"/>
  <Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
 </Style>
 <Style x:Key="WorkspaceCenteredColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceColumnHeader}">
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
 </Style>
 <Style x:Key="WorkspaceTableText" TargetType="TextBlock">
  <Setter Property="Margin" Value="12,0"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 </Style>
 <Style x:Key="WorkspaceSecondaryText" TargetType="TextBlock">
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
 </Style>
 <Style x:Key="SettingsForm" TargetType="Border">
  <Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
  <Setter Property="MaxWidth" Value="1008"/>
  <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="Padding" Value="24,16,24,20"/>
 </Style>
 <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="16"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Margin" Value="0,0,0,4"/>
 </Style>
 <Style x:Key="SettingsFieldLabel" TargetType="Label">
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="Margin" Value="0,8,0,4"/>
 </Style>
 <Style x:Key="SettingsSectionDivider" TargetType="Border">
  <Setter Property="Height" Value="1"/>
  <Setter Property="Margin" Value="0,16,0,12"/>
  <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
 </Style>
 <Style x:Key="WorkspaceLog" TargetType="ui:TextBox">
  <Setter Property="FontFamily" Value="{StaticResource WorkspaceMonoTypeface}"/>
  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
 </Style>
</ResourceDictionary>

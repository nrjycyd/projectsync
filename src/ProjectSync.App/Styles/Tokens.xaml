<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <SolidColorBrush x:Key="Accent" Color="#106849"/>
  <SolidColorBrush x:Key="AccentHover" Color="#0D573E"/>
  <SolidColorBrush x:Key="Ink" Color="#171A1D"/>
  <SolidColorBrush x:Key="InkSecondary" Color="#535F58"/>
  <SolidColorBrush x:Key="InkMuted" Color="#646C75"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AppBackground" Color="#FAFAFA"/>
  <SolidColorBrush x:Key="SurfaceAlt" Color="#F1F3F3"/>
  <SolidColorBrush x:Key="ButtonHoverSurface" Color="#E4EBE7"/>
  <SolidColorBrush x:Key="DangerHoverSurface" Color="#F7DADA"/>
  <SolidColorBrush x:Key="Line" Color="#CDD1D4"/>
  <SolidColorBrush x:Key="LineStrong" Color="#A4ADB3"/>
  <SolidColorBrush x:Key="SuccessBackground" Color="#DCEFE0"/>
  <SolidColorBrush x:Key="SuccessForeground" Color="#135C2D"/>
  <SolidColorBrush x:Key="DangerBackground" Color="#FCE8E8"/>
  <SolidColorBrush x:Key="DangerForeground" Color="#982B2B"/>
  <SolidColorBrush x:Key="WarningBackground" Color="#FFF4D6"/>
  <SolidColorBrush x:Key="WarningForeground" Color="#7A4A00"/>
  <SolidColorBrush x:Key="InfoBackground" Color="#E4F0F3"/>
  <SolidColorBrush x:Key="InfoForeground" Color="#175D73"/>

  <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>
  <FontWeight x:Key="Regular">Normal</FontWeight>
  <FontWeight x:Key="Semibold">SemiBold</FontWeight>

  <sys:Double x:Key="FontSize12">12</sys:Double>
  <sys:Double x:Key="FontSize13">13</sys:Double>
  <sys:Double x:Key="FontSize14">14</sys:Double>
  <sys:Double x:Key="FontSize16">16</sys:Double>
  <sys:Double x:Key="FontSize20">20</sys:Double>
  <sys:Double x:Key="Space4">4</sys:Double>
  <sys:Double x:Key="Space8">8</sys:Double>
  <sys:Double x:Key="Space12">12</sys:Double>
  <sys:Double x:Key="Space16">16</sys:Double>
  <sys:Double x:Key="Space24">24</sys:Double>
  <sys:Double x:Key="Space32">32</sys:Double>
  <sys:Double x:Key="ControlRadius">5</sys:Double>
  <sys:Double x:Key="MenuRadius">6</sys:Double>
  <sys:Double x:Key="DialogRadius">8</sys:Double>
  <CornerRadius x:Key="ButtonCornerRadius">5</CornerRadius>
</ResourceDictionary>

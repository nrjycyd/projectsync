<Window x:Class="ProjectSync.App.Views.WslManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WSL 环境管理" Width="1120" Height="540" MinWidth="740" MinHeight="420"
 WindowStartupLocation="CenterOwner" Background="#FAFAFA" FontSize="14" Foreground="#171A1D" UseLayoutRounding="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="CompactDesktopStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  <Style x:Key="EnvironmentIcon" TargetType="Image">
   <Setter Property="Width" Value="18"/>
   <Setter Property="Height" Value="18"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <CornerRadius x:Key="ControlRadius">4</CornerRadius>
  <SolidColorBrush x:Key="Ink" Color="#171A1D"/>
  <SolidColorBrush x:Key="Line" Color="#AEB6BF"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="MinHeight" Value="35"/>
   <Setter Property="Margin" Value="0,0,8,4"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#F1F3F3"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="Template" Value="{StaticResource CompactButtonTemplate}"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="WslPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#08743B"/>
   <Setter Property="BorderBrush" Value="#08743B"/>
   <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style x:Key="WslRowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="8,2"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{StaticResource TableHeaderSurface}"/>
   <Setter Property="Padding" Value="14,0"/>
   <Setter Property="BorderBrush" Value="#D5DADE"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="DataGridCell">
      <Border Background="Transparent" Padding="14,0,6,0">
       <ContentPresenter VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  </ResourceDictionary>
 </Window.Resources>
 <DockPanel Margin="20">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <StackPanel x:Name="Toolbar" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
    <Button Content="↻ 刷新检测" Click="RefreshClick"/>
    <Button Content="＋ 安装发行版" Click="InstallClick"/>
    <Button Content="↑ 更新 WSL" Click="UpdateClick"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="WSL 环境管理" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="VersionText" FontSize="14" Foreground="#66717B" Margin="12,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"/>
  <Expander x:Name="LogArea" DockPanel.Dock="Bottom" Header="运行日志" Margin="0,10,0,0">
   <TextBox x:Name="Log" Height="105" Margin="0,6,0,0" Padding="8" FontSize="13"
            IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
  </Expander>
  <Border x:Name="InstanceFrame" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
  <DataGrid x:Name="Instances" SizeChanged="InstanceGridSizeChanged" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
            HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="{StaticResource TableGridLine}" VerticalGridLinesBrush="{StaticResource TableGridLine}"
            RowHeight="36" ColumnHeaderHeight="36" BorderThickness="0" Background="Transparent">
   <DataGrid.RowStyle>
    <Style TargetType="DataGridRow">
     <Setter Property="Foreground" Value="{StaticResource Ink}"/>
     <Setter Property="Background" Value="White"/>
     <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF5EC"/></Trigger>
     </Style.Triggers>
    </Style>
   </DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="实例名称" Width="1.2*">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
       <Border CornerRadius="4" Background="#D8EEDC" Padding="6,1" Margin="8,0,0,0">
        <Border.Style>
         <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger></Style.Triggers>
         </Style>
        </Border.Style>
        <TextBlock Text="默认" Foreground="#176339" FontSize="12"/>
       </Border>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="发行版版本" Width="176">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding DistributionHint}"
                  AutomationProperties.Name="{Binding DistributionHint}">
       <Image Source="{Binding DistributionIcon}" Style="{StaticResource EnvironmentIcon}" Margin="0,0,8,0"/>
       <TextBlock Text="{Binding Distribution}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="WSL 版本" Binding="{Binding Version}" Width="94"/>
    <DataGridTextColumn Header="安装位置" Binding="{Binding Location}" Width="2*"/>
    <DataGridTextColumn Header="磁盘上限" Binding="{Binding DiskLimit}" Width="106"/>
    <DataGridTemplateColumn Header="开发环境" Width="120">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Grid>
       <TextBlock Text="{Binding ToolStatus}" Foreground="#66717B" FontSize="13" VerticalAlignment="Center"/>
       <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="Transparent" Width="24" Height="24" ToolTip="{Binding Caption}"
                 AutomationProperties.Name="{Binding Caption}">
          <Image Source="{Binding Icon}" Style="{StaticResource EnvironmentIcon}"/>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </Grid>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="操作" Width="222">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="›_ 启动终端" Click="LaunchClick" Style="{StaticResource WslRowButton}" Foreground="#08743B" BorderBrush="#53936A"/>
       <Button Content="更多 ▾" Click="MoreClick" Style="{StaticResource WslRowButton}">
        <Button.ContextMenu>
         <ContextMenu Style="{StaticResource CompactPopupMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="配置开发环境…" Click="ConfigureDevelopmentClick"/>
          <MenuItem Header="设为默认" Click="DefaultClick"/>
          <MenuItem Header="调整磁盘上限…" Click="ResizeClick"/>
          <MenuItem Header="导出备份…" Click="ExportClick"/>
          <Separator/>
          <MenuItem Header="注销并删除…" Foreground="#A42525" Click="DeleteClick"/>
         </ContextMenu>
        </Button.ContextMenu>
       </Button>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  </Border>
 </DockPanel>
</Window>

<ui:FluentWindow x:Class="ProjectSync.App.Views.WslManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WSL 环境管理" Width="1120" Height="540" MinWidth="740" MinHeight="420"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}" FontSize="14" FontFamily="{StaticResource WorkspaceTypeface}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" UseLayoutRounding="True">

 <ui:FluentWindow.Resources>
  <Thickness x:Key="InstanceCellInset">10,0</Thickness>
  <Style x:Key="InstanceColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceColumnHeader}">
   <Setter Property="Padding" Value="{StaticResource InstanceCellInset}"/>
  </Style>
  <Style x:Key="InstanceTextCell" TargetType="TextBlock">
   <Setter Property="Margin" Value="{StaticResource InstanceCellInset}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Style>
 </ui:FluentWindow.Resources>
 <DockPanel>
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="WSL 环境管理"/>
  <DockPanel Margin="20,16,20,16">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <StackPanel x:Name="Toolbar" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
    <ui:Button Content="刷新检测" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0" Click="RefreshClick"/>
    <ui:Button Content="安装发行版" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Margin="0,0,8,0" Click="InstallClick"/>
    <ui:Button Content="更新 WSL" Icon="{ui:SymbolIcon ArrowUpload24}" Click="UpdateClick"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="发行版" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="VersionText" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>
  <ScrollViewer DockPanel.Dock="Top" MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ui:InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
  </ScrollViewer>
  <Expander x:Name="LogArea" DockPanel.Dock="Bottom" Header="运行日志" Margin="0,8,0,0">
   <ui:TextBox x:Name="Log" Style="{StaticResource WorkspaceLog}" Height="105" Margin="0,6,0,0" Padding="8"
            IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
  </Expander>
  <Border x:Name="InstanceFrame" SnapsToDevicePixels="True" Style="{StaticResource WorkspacePanel}">
  <ui:DataGrid x:Name="Instances" ColumnHeaderStyle="{StaticResource InstanceColumnHeader}" SizeChanged="InstanceGridSizeChanged" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
            HeadersVisibility="Column" ScrollViewer.HorizontalScrollBarVisibility="Auto" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            RowHeight="42" ColumnHeaderHeight="38" BorderThickness="0" Background="Transparent">
   <DataGrid.RowStyle>
    <Style TargetType="DataGridRow">
     <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
     <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
     <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
     </Style.Triggers>
    </Style>
   </DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="实例名称" Width="*" MinWidth="100" MaxWidth="176">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <DockPanel Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center">
       <Border DockPanel.Dock="Right" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="6,1" Margin="8,0,0,0">
        <Border.Style>
         <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger></Style.Triggers>
         </Style>
        </Border.Style>
        <TextBlock Text="默认" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="12"/>
       </Border>
       <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="发行版" Width="106">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <DockPanel Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center" Background="Transparent"
                 ToolTip="{Binding Distribution}" AutomationProperties.Name="{Binding DistributionHint}">
       <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
        <Image Source="{Binding DistributionIcon}" Stretch="Uniform"/>
        <ui:SymbolIcon Symbol="Desktop24" FontSize="16">
         <ui:SymbolIcon.Style>
          <Style TargetType="ui:SymbolIcon">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding DistributionIcon}" Value="{x:Null}">
             <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
             <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
       </Grid>
       <TextBlock Text="{Binding Distribution}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="WSL" Binding="{Binding Version}" Width="60" ElementStyle="{StaticResource InstanceTextCell}"/>
    <DataGridTextColumn Header="安装位置" Binding="{Binding Location}" Width="1.55*" MinWidth="76" MaxWidth="248"
                        ElementStyle="{StaticResource InstanceTextCell}"/>
    <DataGridTemplateColumn Header="磁盘容量" Width="1.1*" MinWidth="106" MaxWidth="172">
     <DataGridTemplateColumn.HeaderStyle>
      <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource InstanceColumnHeader}">
       <Setter Property="HorizontalContentAlignment" Value="Right"/>
      </Style>
     </DataGridTemplateColumn.HeaderStyle>
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel Margin="{StaticResource InstanceCellInset}" Background="Transparent" VerticalAlignment="Center" ToolTip="{Binding Disk.Hint}"
                  AutomationProperties.Name="{Binding Disk.Hint}">
       <TextBlock Text="{Binding Disk.Label}" FontSize="13" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
       <ProgressBar Value="{Binding Disk.Percent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,4,0,0"
                                AutomationProperties.Name="剩余空间比例">
        <ProgressBar.Style>
         <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
          <Style.Triggers>
           <DataTrigger Binding="{Binding Disk.HasMeasurement}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
           <DataTrigger Binding="{Binding Disk.IsLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/></DataTrigger>
          </Style.Triggers>
         </Style>
        </ProgressBar.Style>
       </ProgressBar>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="开发环境" Width="1.05*" MinWidth="96" MaxWidth="160">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Grid Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center">
       <TextBlock Text="{Binding ToolStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                  VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolStatus}"/>
       <ItemsControl ItemsSource="{Binding Tools}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="Transparent" Height="24" ToolTip="{Binding Caption}"
                 AutomationProperties.Name="{Binding Caption}">
          <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16"/>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </Grid>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Header="操作" Width="1.5*" MinWidth="148" MaxWidth="208">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Grid Margin="{StaticResource InstanceCellInset}" VerticalAlignment="Center">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <ui:Button Height="30" HorizontalAlignment="Stretch" Content="终端" ToolTip="启动终端" AutomationProperties.Name="启动终端" Icon="{ui:SymbolIcon WindowConsole20, FontSize=14}" Padding="4,0" Click="LaunchClick" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
       <ui:DropDownButton Grid.Column="2" Height="30" HorizontalAlignment="Stretch" Padding="6,0" Content="更多" Appearance="Secondary" PreviewKeyDown="MenuKeyDown">
        <ui:DropDownButton.Flyout>
         <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <ui:MenuItem Header="配置开发环境…" Click="ConfigureDevelopmentClick"/>
          <ui:MenuItem Header="设为默认" Click="DefaultClick"/>
          <ui:MenuItem Header="调整磁盘上限…" Click="ResizeClick"/>
          <ui:MenuItem Header="导出备份…" Click="ExportClick"/>
          <Separator/>
          <ui:MenuItem Header="注销并删除…" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Click="DeleteClick"/>
         </ContextMenu>
        </ui:DropDownButton.Flyout>
       </ui:DropDownButton>
      </Grid>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </ui:DataGrid>
  </Border>
  </DockPanel>
 </DockPanel>
</ui:FluentWindow>

<ui:FluentWindow x:Class="ProjectSync.App.Views.FileCopyWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="文件复制" Width="680" Height="626" MinWidth="490" MinHeight="515"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource ApplicationBackgroundBrush}"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" FontFamily="{StaticResource WorkspaceTypeface}" UseLayoutRounding="True">

 <DockPanel>
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="文件复制"/>
  <DockPanel Margin="20,16,20,16">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:Button x:Name="CancelCopy" Content="取消" Click="CancelClick" Visibility="Collapsed" Margin="0,0,8,0"/>
    <ui:Button x:Name="PreviewCopy" Content="预览复制" Appearance="Primary" IsEnabled="False" Click="PreviewClick" Margin="0,0,8,0"/>
    <ui:Button x:Name="StartCopy" Content="开始复制" Appearance="Secondary" IsEnabled="False" Icon="{ui:SymbolIcon Copy24}" Click="CopyClick"/>
   </StackPanel>
   <TextBlock x:Name="CopyStatus" Style="{StaticResource WorkspaceSecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Top" x:Name="CopyOptions">
   <DockPanel Margin="0,0,0,4">
    <ComboBox x:Name="SourceLocation" DockPanel.Dock="Right" Width="184" SelectionChanged="EndpointChanged" AutomationProperties.Name="来源位置"/>
    <Label Content="来源文件或目录" Target="{Binding ElementName=SourcePath}" Padding="0" VerticalAlignment="Center"/>
   </DockPanel>
   <DockPanel Margin="0,0,0,10">
    <ui:Button DockPanel.Dock="Right" Content="选目录…" Click="BrowseSourceFolder" Margin="8,0,0,0"/>
    <ui:Button DockPanel.Dock="Right" Content="选文件…" Click="BrowseSourceFile" Margin="8,0,0,0"/>
    <ui:TextBox x:Name="SourcePath" TextChanged="OptionsChanged"/>
   </DockPanel>
   <DockPanel Margin="0,0,0,4">
    <ComboBox x:Name="TargetLocation" DockPanel.Dock="Right" Width="184" SelectionChanged="EndpointChanged" AutomationProperties.Name="目标位置"/>
    <ui:Button x:Name="SwapEndpoints" DockPanel.Dock="Right" Content="交换" IsEnabled="False" Icon="{ui:SymbolIcon ArrowSwap24}" Click="SwapClick" Margin="0,0,8,0"
               ToolTip="仅在来源和目标均为现有目录时交换" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="交换来源和目标" VerticalAlignment="Center"/>
    <Label Content="目标目录" Target="{Binding ElementName=TargetPath}" Padding="0" VerticalAlignment="Center"/>
   </DockPanel>
   <DockPanel>
    <ui:Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseTargetFolder" Margin="8,0,0,0"/>
    <ui:TextBox x:Name="TargetPath" TextChanged="OptionsChanged"/>
   </DockPanel>
   <TextBlock x:Name="SwapFeedback" Style="{StaticResource WorkspaceSecondaryText}" Margin="0,4,0,0"
              Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel Margin="0,8,0,0">
    <Label Content="同名文件" Target="{Binding ElementName=Conflict}" VerticalAlignment="Center" Padding="0,0,8,0"/>
    <ComboBox x:Name="Conflict" Width="109" SelectedIndex="0" SelectionChanged="OptionsChanged">
     <ComboBoxItem Content="跳过"/>
     <ComboBoxItem Content="覆盖"/>
    </ComboBox>
    <ui:ToggleSwitch x:Name="SkipMarks" OnContent="跳过 Zone.Identifier 下载标记" OffContent="跳过 Zone.Identifier 下载标记" IsChecked="True"
              Checked="OptionsChanged" Unchecked="OptionsChanged" VerticalAlignment="Center" Margin="14,0,0,0"/>
   </WrapPanel>
   <TextBlock Margin="0,8,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="复制目录时，会在目标目录下保留来源目录名。" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Style="{StaticResource WorkspacePanel}">
  <ui:DataGrid x:Name="Changes" ColumnHeaderStyle="{StaticResource WorkspaceColumnHeader}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
            HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0" Background="Transparent" RowHeight="29">
   <DataGrid.Columns>
    <DataGridTextColumn Header="操作" Width="120" Binding="{Binding Action}"/>
    <DataGridTextColumn Header="目标相对路径" Width="*" MinWidth="160" Binding="{Binding Path}"/>
   </DataGrid.Columns>
  </ui:DataGrid>
  </Border>
  </DockPanel>
 </DockPanel>
</ui:FluentWindow>

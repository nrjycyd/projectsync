<ui:FluentWindow x:Class="ProjectSync.App.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ProjectSync.App.Views"
 Title="ProjectSync" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica" Width="1228" Height="816" MinWidth="780" MinHeight="530"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" UseLayoutRounding="True" FontFamily="{StaticResource WorkspaceTypeface}" Icon="/ProjectSync.App;component/Assets/ProjectSync.ico">

 <ui:FluentWindow.Resources>
  <ContextMenu x:Key="ProjectRowMenu" x:Shared="False" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
   <ui:MenuItem Header="移除项目" Icon="{ui:SymbolIcon SubtractCircle16, FontSize=16}"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}" Click="RemoveProject"/>
  </ContextMenu>
  <Style x:Key="ToolbarMenuIcon" TargetType="ui:SymbolIcon">
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="Width" Value="18"/>
   <Setter Property="Height" Value="18"/>
  </Style>
  <ControlTemplate x:Key="SettingsTabsLayout" TargetType="TabControl">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="168"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
            Background="{DynamicResource LayerOnMicaBaseAltFillColorSecondaryBrush}" Padding="8,8,8,0">
     <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
    </Border>
    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
   </Grid>
  </ControlTemplate>
 </ui:FluentWindow.Resources>
 <DockPanel Background="Transparent">
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="ProjectSync"/>
  <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <DockPanel x:Name="HomePage" Margin="24,16,24,16" Background="Transparent" TextElement.FontSize="14">
   <local:HomeToolbarPanel DockPanel.Dock="Top" Margin="0,0,0,12">
    <WrapPanel x:Name="BatchActions" Orientation="Horizontal" HorizontalAlignment="Left">
     <WrapPanel.Resources>
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource TextFillColorPrimary}"/>
     </WrapPanel.Resources>
     <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Play24}" Margin="0,0,6,0" Padding="10,4" MinHeight="34" x:Name="PreviewBatchButton" MinWidth="122" Content="构建并预览" Click="PreviewSelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
     <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,6,0" Padding="10,4" MinHeight="34" x:Name="ApplyBatchButton" MinWidth="99" Content="应用同步" Click="ApplySelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
     <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUpload24}" Margin="0,0,6,0" Padding="10,4" MinHeight="34" x:Name="PublishBatchButton" MinWidth="112" Content="提交并推送" Click="PublishSelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
     <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,6,0" Padding="10,4" MinHeight="34" x:Name="RetryPushButton" Content="重试推送"
             Visibility="Collapsed" Click="RetryPushSelected"/>
    </WrapPanel>
     <WrapPanel x:Name="HomeActions" Orientation="Horizontal">
      <ui:SplitButton x:Name="NewProjectButton" Content="新建项目" Appearance="Primary"
                      MinWidth="116" MinHeight="34" Margin="0,0,8,0" Click="NewProject" PreviewKeyDown="MenuKeyDown">
       <ui:SplitButton.Style>
        <Style TargetType="ui:SplitButton" BasedOn="{StaticResource {x:Type ui:SplitButton}}">
         <Style.Triggers>
          <Trigger Property="Appearance" Value="Primary">
           <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
           <Setter Property="MouseOverBackground" Value="{DynamicResource AccentButtonBackgroundPointerOver}"/>
           <Setter Property="PressedBackground" Value="{DynamicResource AccentButtonBackgroundPressed}"/>
           <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}"/>
           <Setter Property="PressedForeground" Value="{DynamicResource AccentButtonForegroundPointerOver}"/>
          </Trigger>
         </Style.Triggers>
        </Style>
       </ui:SplitButton.Style>
       <ui:SplitButton.Flyout>
        <ContextMenu>
         <ui:MenuItem Header="导入 JSON" Click="ImportProject">
          <ui:MenuItem.Icon>
           <ui:SymbolIcon Symbol="FolderOpen16" Style="{StaticResource ToolbarMenuIcon}"/>
          </ui:MenuItem.Icon>
         </ui:MenuItem>
        </ContextMenu>
       </ui:SplitButton.Flyout>
      </ui:SplitButton>
      <ui:DropDownButton x:Name="ToolsButton" Content="工具" Appearance="Secondary" MinHeight="34" PreviewKeyDown="MenuKeyDown">
       <ui:DropDownButton.Flyout>
        <local:RightAlignedContextMenu Style="{StaticResource {x:Type ContextMenu}}">
         <ui:MenuItem Header="文件复制" Click="OpenFileCopy">
          <ui:MenuItem.Icon>
           <ui:SymbolIcon Symbol="Copy16" Style="{StaticResource ToolbarMenuIcon}"/>
          </ui:MenuItem.Icon>
         </ui:MenuItem>
         <ui:MenuItem Header="WSL 环境" Click="OpenWslManager">
          <ui:MenuItem.Icon>
           <ui:SymbolIcon Symbol="Desktop16" Style="{StaticResource ToolbarMenuIcon}"/>
          </ui:MenuItem.Icon>
         </ui:MenuItem>
        </local:RightAlignedContextMenu>
       </ui:DropDownButton.Flyout>
      </ui:DropDownButton>
     </WrapPanel>
   </local:HomeToolbarPanel>
   <Border x:Name="BatchProgressPanel" DockPanel.Dock="Top" Style="{StaticResource WorkspacePanel}"
           Margin="0,0,0,8" Padding="12,6" Visibility="Collapsed">
    <DockPanel>
     <ui:Button x:Name="StopBatchButton" DockPanel.Dock="Right" Appearance="Secondary"
                Margin="12,0,0,0" Content="停止" Click="StopBatch"
                ToolTip="取消构建和预览，或在当前同步或推送结束后停止批量操作"/>
     <TextBlock x:Name="BatchProgressText" VerticalAlignment="Center" TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
   </Border>
   <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="0,6,0,2"
           BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
    <DockPanel>
     <StackPanel x:Name="FooterActions" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:Button Appearance="Secondary" x:Name="ExportDiagnosticsButton" MinWidth="88" MinHeight="34" VerticalAlignment="Stretch" Padding="12,0" FontSize="13" Margin="0,0,12,0" Content="导出诊断" Click="ExportDiagnostics"/>
      <TextBlock x:Name="ThemeChoiceCaption" Text="主题" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      <ComboBox x:Name="ThemeChoice" MinWidth="112" VerticalAlignment="Stretch" Margin="0,0,12,0" FontSize="13" SelectedIndex="1"
                SelectionChanged="ChooseTheme" AutomationProperties.LabeledBy="{Binding ElementName=ThemeChoiceCaption}">
       <ComboBox.Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
         <Setter Property="Popup.Placement" Value="Top"/>
        </Style>
       </ComboBox.Style>
       <ComboBoxItem Content="跟随系统" Tag="System"/>
       <ComboBoxItem Content="浅色" Tag="Light"/>
       <ComboBoxItem Content="深色" Tag="Dark"/>
      </ComboBox>
      <ui:Button Appearance="Secondary" x:Name="CheckUpdatesButton" MinWidth="112" MinHeight="34" VerticalAlignment="Stretch" Padding="8,0"
                 FontSize="13" Click="CheckUpdates" AutomationProperties.Name="{Binding Text, ElementName=UpdateActionText}">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="UpdateActionText" Text="检查更新" MinWidth="52" VerticalAlignment="Center"/>
        <TextBlock x:Name="AppVersionText" Margin="6,0,0,0" VerticalAlignment="Center">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="False">
             <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </ui:Button>
     </StackPanel>
    </DockPanel>
   </Border>
   <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ui:InfoBar x:Name="HomeStatus" IsOpen="False" IsClosable="True" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   </ScrollViewer>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="38*" MinHeight="104"/>
     <RowDefinition Height="28"/>
     <RowDefinition Height="62*" MinHeight="120"/>
    </Grid.RowDefinitions>
    <Grid>
     <Border x:Name="ProjectTableFrame" Style="{StaticResource WorkspacePanel}">
    <ui:DataGrid x:Name="Projects" ColumnHeaderStyle="{StaticResource WorkspaceColumnHeader}" SizeChanged="DashboardTableSizeChanged" RowHeight="36" GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" SelectionMode="Single" ColumnHeaderHeight="36"

              SelectionChanged="ProjectSelectionChanged">
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <EventSetter Event="MouseDoubleClick" Handler="OpenProjectRow"/>
       <EventSetter Event="ContextMenuOpening" Handler="ProjectRowMenuOpening"/>
       <Setter Property="ContextMenu" Value="{DynamicResource ProjectRowMenu}"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Checked}" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="勾选" Width="66" MinWidth="66" CanUserSort="False" HeaderStyle="{StaticResource WorkspaceCenteredColumnHeader}">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Click="ProjectCheckChanged" AutomationProperties.Name="{Binding Name}"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="项目名称" Width="1.5*" MinWidth="98" Binding="{Binding Name}" ElementStyle="{StaticResource WorkspaceTableText}"/>
      <DataGridTextColumn Header="Git 远端仓库" Width="2.65*" MinWidth="118" Binding="{Binding RemoteRepository}" ElementStyle="{StaticResource WorkspaceTableText}"/>
      <DataGridTextColumn Header="Git 本地仓库" Width="2.8*" MinWidth="118" Binding="{Binding Repository}" ElementStyle="{StaticResource WorkspaceTableText}"/>
      <DataGridTemplateColumn Header="快捷访问" Width="198" MinWidth="192" CanUserSort="False" HeaderStyle="{StaticResource WorkspaceCenteredColumnHeader}">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Local" Click="OpenRepositoryShortcut"
                 ToolTip="打开 Git 本地仓库" AutomationProperties.Name="打开 Git 本地仓库">
          <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Wsl" Click="OpenRepositoryShortcut"
                 ToolTip="打开本地构建环境" AutomationProperties.Name="打开本地构建环境">
          <ui:SymbolIcon Symbol="Desktop24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="WslTerminal" Click="OpenRepositoryShortcut"
                 ToolTip="在终端打开 WSL 项目目录" AutomationProperties.Name="在终端打开 WSL 项目目录">
          <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Remote" Click="OpenRepositoryShortcut"
                 ToolTip="打开 Git 远端仓库" AutomationProperties.Name="打开 Git 远端仓库">
          <ui:SymbolIcon Symbol="Globe24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Reinstall" Click="OpenRepositoryShortcut"
                 ToolTip="重装依赖" AutomationProperties.Name="重装依赖">
          <ui:SymbolIcon Symbol="Box24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="UpgradeTheme" Click="OpenRepositoryShortcut"
                 ToolTip="升级主题" AutomationProperties.Name="升级主题">
          <ui:SymbolIcon Symbol="PaintBrush24" FontSize="16"/>
         </ui:Button>
        </StackPanel>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="进度" Width="1.45*" MinWidth="102" SortMemberPath="Progress">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <ui:Badge HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
         <ui:Badge.Style>
          <Style TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
           <Setter Property="Appearance" Value="Secondary"/>
           <Setter Property="Content" Value="{Binding Progress}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Progress}" Value="待构建">
             <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="无需推送">
             <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="可同步"><Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="可推送"><Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="已提交，待推送">
             <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
             <Setter Property="Content" Value="待推送"/>
             <Setter Property="ToolTip" Value="{Binding Progress}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="已推送"><Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="操作失败"><Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </ui:Badge.Style>
        </ui:Badge>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </ui:DataGrid>
     </Border>
     <Border x:Name="EmptyProjects" Style="{StaticResource WorkspacePanel}" Visibility="Collapsed">
      <TextBlock Text="还没有项目，可以新建项目或导入 JSON。" Margin="16" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
    </Grid>
    <GridSplitter Grid.Row="1" Height="14" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="调整项目列表和结果区高度">
     <GridSplitter.Template>
      <ControlTemplate TargetType="GridSplitter">
       <Grid Background="Transparent">
        <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Border Width="32" Height="9" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" HorizontalAlignment="Center">
         <StackPanel VerticalAlignment="Center" Margin="4,0">
          <Border Height="1" Background="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2"/>
          <Border Height="1" Background="{DynamicResource TextFillColorTertiaryBrush}"/>
         </StackPanel>
        </Border>
       </Grid>
      </ControlTemplate>
     </GridSplitter.Template>
    </GridSplitter>
    <TabControl Grid.Row="2" x:Name="HomeResults" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
     <TabItem Header="变更清单" x:Name="HomeChangesTab">
      <DockPanel Margin="10,12,10,10" TextElement.FontWeight="Normal">
       <TextBlock x:Name="HomeChangesSummary" Style="{StaticResource WorkspaceSecondaryText}" DockPanel.Dock="Top" Margin="12,0,0,12" Text="构建并预览后显示待同步变更。"/>
       <Border Style="{StaticResource WorkspacePanel}">
       <ui:DataGrid x:Name="HomeChanges" ColumnHeaderStyle="{StaticResource WorkspaceColumnHeader}" Background="Transparent" BorderThickness="0" SizeChanged="DashboardTableSizeChanged" RowHeight="36" GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" ColumnHeaderHeight="36">
        <DataGrid.GroupStyle>
         <GroupStyle>
          <GroupStyle.HeaderTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Padding="8,4">
             <TextBlock.Style>
              <Style TargetType="TextBlock">
               <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="目标清理（永久删除）">
                 <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
           </DataTemplate>
          </GroupStyle.HeaderTemplate>
         </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.Columns>
         <DataGridTextColumn Header="项目" Width="1.15*" MinWidth="100" Binding="{Binding Project}" ElementStyle="{StaticResource WorkspaceTableText}"/>
         <DataGridTextColumn Header="操作" Width="0.6*" MinWidth="85" Binding="{Binding Action}" ElementStyle="{StaticResource WorkspaceTableText}"/>
         <DataGridTextColumn Header="路径" Width="2.75*" MinWidth="160" Binding="{Binding Path}" ElementStyle="{StaticResource WorkspaceTableText}"/>
        </DataGrid.Columns>
       </ui:DataGrid>
       </Border>
      </DockPanel>
     </TabItem>
     <TabItem Header="运行日志" x:Name="HomeLogTab">
      <ui:TextBox x:Name="HomeLog" Style="{StaticResource WorkspaceLog}" FontWeight="Normal" Margin="10" Padding="14,10" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
     </TabItem>
    </TabControl>
   </Grid>
  </DockPanel>
  <DockPanel x:Name="ProjectPage" Visibility="Collapsed" Background="Transparent" TextElement.FontSize="14" TextElement.FontWeight="Normal">
  <Border DockPanel.Dock="Top" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,12">
   <StackPanel>
   <WrapPanel x:Name="Actions">
    <ui:Button Appearance="Secondary" Margin="0,0,8,0" Content="← 返回项目列表" Click="BackToHome"/>
    <ui:Button x:Name="SaveProjectButton" Appearance="Secondary" IsEnabled="False" Margin="0,0,8,0" Content="保存项目" Click="SaveProject"/>
    <ui:Button Appearance="Secondary" Content="导出 JSON" Click="Save" ToolTip="将当前表单导出成 JSON 文件"/>
   </WrapPanel>
   <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ui:InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
   </ScrollViewer>
   </StackPanel>
  </Border>
   <TabControl x:Name="SettingsTabs" TabStripPlacement="Left" Template="{StaticResource SettingsTabsLayout}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <TabItem x:Name="RemoteSettingsTab" Header="Git 远端仓库">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource SettingsForm}">
       <StackPanel>
        <TextBlock Text="仓库连接" Style="{StaticResource SettingsSectionTitle}"/>
        <WrapPanel>
         <StackPanel Width="352" Margin="0,0,16,0">
          <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=remote}" Content="远端名称"/>
          <DockPanel>
           <ui:Button Appearance="Secondary" DockPanel.Dock="Right" Content="检测远端名称" Click="DetectRemotes" ToolTip="从 Git 本地仓库的仓库路径读取远端名称" Margin="8,0,0,0" VerticalAlignment="Stretch" MinHeight="34"/>
           <ComboBox x:Name="remote" VerticalAlignment="Stretch" IsEditable="True" IsTextSearchEnabled="False" ToolTip="例如 origin"/>
          </DockPanel>
         </StackPanel>
         <StackPanel Width="224">
          <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=branch}" Content="目标分支"/>
          <ComboBox x:Name="branch" IsEditable="True" IsTextSearchEnabled="False"/>
         </StackPanel>
        </WrapPanel>
        <ui:InfoBar x:Name="RemoteDetectionStatus" IsOpen="False" IsClosable="False" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=remoteUrl}" Content="远端仓库地址"/>
        <ui:TextBox x:Name="remoteUrl" ToolTip="git@github.com:账号/仓库.git 或 https://github.com/账号/仓库.git"/>
        <TextBlock Text="留空时使用远端名称" Style="{StaticResource WorkspaceSecondaryText}" Margin="0,4,0,0"/>
        <Expander x:Name="RemoteConnectionOptions" Header="连接选项" Margin="0,12,0,0">
         <StackPanel Margin="12,0,12,12">
          <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=githubUsername}" Content="GitHub 用户名（HTTPS，可选）"/>
          <ui:TextBox x:Name="githubUsername" Width="256" HorizontalAlignment="Left" ToolTip="填写此项目用来授权的账号，可以与仓库所有者不同。"/>
          <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=gitSshCommand}" Content="SSH 命令与参数（可选）"/>
          <ui:TextBox x:Name="gitSshCommand"/>
         </StackPanel>
        </Expander>
        <ui:Button Appearance="Secondary" HorizontalAlignment="Left" Margin="0,12,0,0" Content="测试远端连接" Click="TestRemote"/>
        <ui:InfoBar x:Name="RemoteTestStatus" IsOpen="False" IsClosable="False" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="LocalSettingsTab" Header="Git 本地仓库">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource SettingsForm}">
       <StackPanel>
        <TextBlock Text="项目与仓库" Style="{StaticResource SettingsSectionTitle}"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=ProjectName}" Content="项目名称"/>
        <ui:TextBox x:Name="ProjectName" Width="288" HorizontalAlignment="Left"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=windowsRepo}" Content="仓库路径"/>
        <DockPanel>
         <ui:Button Appearance="Secondary" DockPanel.Dock="Right" Content="浏览…" Click="Browse" Margin="8,0,0,0" VerticalAlignment="Stretch" MinHeight="34"/>
         <ui:TextBox x:Name="windowsRepo" VerticalAlignment="Stretch" MinHeight="34"/>
        </DockPanel>
        <ui:Button Appearance="Secondary" HorizontalAlignment="Left" Margin="0,12,0,0" Content="初始化 Git…" Click="InitializeLocalGit"/>
        <ui:InfoBar x:Name="LocalGitStatus" IsOpen="False" IsClosable="False" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="本地构建环境">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource SettingsForm}">
       <StackPanel>
        <TextBlock Text="运行环境" Style="{StaticResource SettingsSectionTitle}"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=wslRepo}" Content="WSL 仓库路径"/>
        <DockPanel>
         <ui:Button Appearance="Secondary" DockPanel.Dock="Right" Content="检测环境" Click="DetectWsl" Margin="8,0,0,0" VerticalAlignment="Stretch" MinHeight="34"/>
         <ui:TextBox x:Name="wslRepo" VerticalAlignment="Stretch" MinHeight="34"/>
        </DockPanel>
        <WrapPanel>
         <StackPanel Width="248" Margin="0,0,16,0">
          <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=WslDistribution}" Content="WSL 发行版"/>
          <ComboBox x:Name="WslDistribution" SelectionChanged="ChooseWslDistribution" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
         </StackPanel>
         <StackPanel Width="248">
          <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=WslUserChoice}" Content="WSL 用户"/>
          <ComboBox x:Name="WslUserChoice" SelectionChanged="ChooseWslUser" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
         </StackPanel>
        </WrapPanel>
        <ui:TextBox x:Name="distro" Visibility="Collapsed"/>
        <ui:TextBox x:Name="wslUser" Visibility="Collapsed"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=NodeVersion}" Content="Node.js 版本"/>
        <ComboBox x:Name="NodeVersion" Width="248" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectionChanged="ChooseNodeVersion" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="NodeHint" TextWrapping="Wrap">
         <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource WorkspaceSecondaryText}">
           <Style.Triggers>
            <Trigger Property="Text" Value="">
             <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <ui:InfoBar x:Name="EnvironmentFeedback" IsOpen="False" IsClosable="False" Margin="0,8,0,0"
                    AutomationProperties.LiveSetting="Polite"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=nodeBin}" Content="额外 PATH 目录（可选）"/>
        <ui:TextBox x:Name="nodeBin"/>

        <Border Style="{StaticResource SettingsSectionDivider}"/>
        <TextBlock Text="构建与预览" Style="{StaticResource SettingsSectionTitle}"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=pullPath}" Content="从远端拉入 WSL 的目录（每行一项）"/>
          <ui:TextBox x:Name="pullPath" AcceptsReturn="True" Height="72" VerticalScrollBarVisibility="Visible"
                      ToolTip="构建前以远端分支为准替换这些目录。仅存在于 WSL 的内容会被删除。"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=buildCommand}" Content="构建命令"/>
        <ui:TextBox x:Name="buildCommand"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=previewCommand}" Content="预览命令（可选）"/>
        <ui:TextBox x:Name="previewCommand" ToolTip="例如 pnpm docs:preview。请在命令输出中提供本地预览地址。"/>
        <ui:ToggleSwitch x:Name="PreviewAfterBuild" Margin="0,8,0,0" OnContent="构建成功后在浏览器打开预览" OffContent="构建成功后在浏览器打开预览" AutomationProperties.Name="构建成功后在浏览器打开预览"/>

        <Border Style="{StaticResource SettingsSectionDivider}"/>
        <TextBlock Text="维护命令" Style="{StaticResource SettingsSectionTitle}"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=reinstallCommand}" Content="重装依赖命令（可选）"/>
        <ui:TextBox x:Name="reinstallCommand" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Visible"
                    ToolTip="在项目的 WSL 根目录执行，每行可填写一条 shell 命令。"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=themeUpgradeCommand}" Content="升级主题命令（可选）"/>
        <ui:TextBox x:Name="themeUpgradeCommand" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Visible"
                    ToolTip="例如 pnpm dlx vp-update。在项目的 WSL 根目录执行。"/>
       </StackPanel>
      </Border>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="同步与清理">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource SettingsForm}">
       <StackPanel>
        <TextBlock Text="同步范围" Style="{StaticResource SettingsSectionTitle}"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=include}" Content="构建通过后同步的路径（每行一项）"/>
        <ui:TextBox x:Name="include" LostKeyboardFocus="NormalizeSyncPathField" AcceptsReturn="True" Height="160" VerticalScrollBarVisibility="Visible"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=exclude}" Content="排除路径（每行一项，可留空）"/>
        <ui:TextBox x:Name="exclude" LostKeyboardFocus="NormalizeSyncPathField" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Visible"/>
        <Label Style="{StaticResource SettingsFieldLabel}" Target="{Binding ElementName=excludeSuffixes}" Content="排除文件名后缀（每行一项，可留空）"/>
        <ui:TextBox x:Name="excludeSuffixes" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Visible"
                    ToolTip="填写文件名结尾，例如 Zone.Identifier 或 .map。"/>

        <Border Style="{StaticResource SettingsSectionDivider}"/>
        <TextBlock Text="目标仓库清理" Style="{StaticResource SettingsSectionTitle}"/>
        <ui:ToggleSwitch x:Name="CleanUntracked" Margin="0,8,0,0" OnContent="同步前永久清理整个目标仓库中未跟踪且未忽略的文件" OffContent="同步前永久清理整个目标仓库中未跟踪且未忽略的文件" AutomationProperties.Name="同步前永久清理整个目标仓库中未跟踪且未忽略的文件"/>
       </StackPanel>
      </Border>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="快速配置" x:Name="JsonSettingsTab">
     <DockPanel Margin="24,16,24,20">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
       <ui:Button DockPanel.Dock="Left" Appearance="Secondary" Margin="0,0,8,0"
                  Content="清空配置" Click="ClearConfiguration"/>
       <WrapPanel HorizontalAlignment="Right">
        <ui:Button Appearance="Secondary" Margin="0,0,8,0" Content="导入文件" Click="Open"/>
        <ui:Button x:Name="ApplyJsonButton" Appearance="Secondary" Content="应用到表单" Click="ApplyJson"/>
       </WrapPanel>
      </DockPanel>
      <ScrollViewer DockPanel.Dock="Top" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ui:InfoBar x:Name="JsonStatus" IsOpen="False" IsClosable="False" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
      </ScrollViewer>
      <ui:TextBox x:Name="Config" Style="{StaticResource WorkspaceLog}"
                  FontFamily="Consolas, Microsoft YaHei UI" FontWeight="Normal"
                  CaretBrush="{Binding Foreground, RelativeSource={RelativeSource Self}}"
                  AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="JSON 配置"/>
     </DockPanel>
    </TabItem>
   </TabControl>
 </DockPanel>
  </Grid>
 </DockPanel>
</ui:FluentWindow>

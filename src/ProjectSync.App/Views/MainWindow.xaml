<ui:FluentWindow x:Class="ProjectSync.App.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ProjectSync" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="Mica" Width="1228" Height="816" MinWidth="780" MinHeight="530"
 Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI" Icon="/ProjectSync.App;component/Assets/ProjectSync.ico">

 <ui:FluentWindow.Resources>
  <ControlTemplate x:Key="SettingsTabsLayout" TargetType="TabControl">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="196"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="8,8,8,0">
     <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
    </Border>
    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
   </Grid>
  </ControlTemplate>
 </ui:FluentWindow.Resources>
 <DockPanel Background="Transparent">
  <ui:TitleBar DockPanel.Dock="Top" ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}" Title="ProjectSync"/>
  <Grid>
  <DockPanel x:Name="HomePage" Margin="26,20,26,16" Background="Transparent" TextElement.FontSize="15">
   <Grid DockPanel.Dock="Top" Margin="0,0,0,12" SizeChanged="HomeToolbarSizeChanged">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel x:Name="BatchActions" Orientation="Horizontal" HorizontalAlignment="Left">
     <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Margin="0,0,8,4" Padding="12,4" Height="34" x:Name="PreviewBatchButton" MinWidth="122" Content="构建并预览" Click="PreviewSelected" IsEnabled="False"/>
     <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,4" Padding="12,4" Height="34" x:Name="ApplyBatchButton" MinWidth="99" Content="应用同步" Click="ApplySelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="对预览成功且已勾选的项目应用同步"/>
     <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUpload24}" Margin="0,0,8,4" Padding="12,4" Height="34" x:Name="PublishBatchButton" MinWidth="112" Content="提交并推送" Click="PublishSelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="提交并推送已应用同步且已勾选的项目"/>
     <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,4" Padding="12,4" Height="34" x:Name="RetryPushButton" Content="重试推送"
             Visibility="Collapsed" Click="RetryPushSelected"/>
     <TextBlock x:Name="SelectionSummary" Margin="10,0,0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
    </StackPanel>
     <StackPanel x:Name="HomeActions" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
      <ui:SplitButton x:Name="NewProjectButton" Content="新建项目" Appearance="Secondary"
                      MinWidth="116" Height="34" Margin="0,0,8,0" Click="NewProject" PreviewKeyDown="MenuKeyDown">
       <ui:SplitButton.Flyout>
        <ContextMenu Opened="ProjectMenuOpened">
         <ui:MenuItem Header="导入 JSON" Icon="{ui:SymbolIcon DocumentArrowDown24}" Click="ImportProject"/>
         <Separator/>
         <ui:MenuItem x:Name="RemoveProjectItem" Header="移除" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                      Click="RemoveProject" IsEnabled="False"/>
        </ContextMenu>
       </ui:SplitButton.Flyout>
      </ui:SplitButton>
      <ui:DropDownButton x:Name="ToolsButton" Content="工具" Appearance="Secondary" MinWidth="116" Height="34" PreviewKeyDown="MenuKeyDown">
       <ui:DropDownButton.Flyout>
        <ContextMenu>
         <ui:MenuItem Header="文件复制" Icon="{ui:SymbolIcon Copy24}" Click="OpenFileCopy"/>
         <ui:MenuItem Header="WSL 环境" Icon="{ui:SymbolIcon Desktop24}" Click="OpenWslManager"/>
        </ContextMenu>
       </ui:DropDownButton.Flyout>
      </ui:DropDownButton>
     </StackPanel>
   </Grid>
   <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="0,1,0,0" MinHeight="20">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
      <ui:Button Appearance="Secondary" x:Name="StopBatchButton" Content="停止" Click="StopBatch" Visibility="Collapsed"
              ToolTip="取消构建和预览，或在当前同步或推送结束后停止批量操作"/>
      <ui:Button Appearance="Secondary" Content="导出诊断" Click="ExportDiagnostics"
              MinHeight="25" Padding="9,2" FontSize="13"/>
      <ComboBox x:Name="ThemeChoice" Width="112" Margin="0,0,8,0" SelectedIndex="0"
                SelectionChanged="ChooseTheme" AutomationProperties.Name="应用主题">
       <ComboBoxItem Content="浅色" Tag="Light"/>
       <ComboBoxItem Content="深色" Tag="Dark"/>
       <ComboBoxItem Content="跟随系统" Tag="System"/>
      </ComboBox>
      <TextBlock x:Name="AppVersionText" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
      <ui:Button Appearance="Secondary" x:Name="CheckUpdatesButton" Content="检查更新" Click="CheckUpdates" MinHeight="25" Padding="9,2"
              Margin="0" FontSize="13"/>
     </StackPanel>
     <TextBlock x:Name="HomeStatus" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </DockPanel>
   </Border>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="38*" MinHeight="104"/>
     <RowDefinition Height="28"/>
     <RowDefinition Height="62*" MinHeight="120"/>
    </Grid.RowDefinitions>
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
    <ui:DataGrid x:Name="Projects" SizeChanged="DashboardTableSizeChanged" RowHeight="36" GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" SelectionMode="Single" ColumnHeaderHeight="36"

              SelectionChanged="ProjectSelectionChanged">
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <EventSetter Event="MouseDoubleClick" Handler="OpenProjectRow"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Checked}" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="勾选" Width="66" MinWidth="66" CanUserSort="False">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Click="ProjectCheckChanged" AutomationProperties.Name="{Binding Name}"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="项目名称" Width="1.5*" MinWidth="115" Binding="{Binding Name}"/>
      <DataGridTextColumn Header="Git 远端仓库" Width="2.65*" MinWidth="150" Binding="{Binding RemoteRepository}"/>
      <DataGridTextColumn Header="Git 本地仓库" Width="2.8*" MinWidth="170" Binding="{Binding Repository}"/>
      <DataGridTemplateColumn Header="快捷访问" Width="198" MinWidth="192" CanUserSort="False">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Local" Click="OpenRepositoryShortcut"
                 ToolTip="打开 Git 本地仓库" AutomationProperties.Name="打开 Git 本地仓库">
          <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Wsl" Click="OpenRepositoryShortcut"
                 ToolTip="打开本地构建环境" AutomationProperties.Name="打开本地构建环境">
          <ui:SymbolIcon Symbol="Desktop24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="WslTerminal" Click="OpenRepositoryShortcut"
                 ToolTip="在终端打开 WSL 项目目录" AutomationProperties.Name="在终端打开 WSL 项目目录">
          <ui:SymbolIcon Symbol="WindowConsole20" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Remote" Click="OpenRepositoryShortcut"
                 ToolTip="打开 Git 远端仓库" AutomationProperties.Name="打开 Git 远端仓库">
          <ui:SymbolIcon Symbol="Globe24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="Reinstall" Click="OpenRepositoryShortcut"
                 ToolTip="重装依赖" AutomationProperties.Name="重装依赖">
          <ui:SymbolIcon Symbol="Box24" FontSize="16"/>
         </ui:Button>
         <ui:Button Appearance="Transparent" Width="29" Height="28" Padding="0" BorderThickness="0" Tag="UpgradeTheme" Click="OpenRepositoryShortcut"
                 ToolTip="升级主题" AutomationProperties.Name="升级主题">
          <ui:SymbolIcon Symbol="PaintBrush24" FontSize="16"/>
         </ui:Button>
        </StackPanel>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="进度" Width="1.45*" MinWidth="110" SortMemberPath="Progress">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <ui:Badge HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Content="{Binding Progress}">
         <ui:Badge.Style>
          <Style TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
           <Setter Property="Appearance" Value="Secondary"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Progress}" Value="待构建">
             <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="无需推送">
             <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="可同步"><Setter Property="Appearance" Value="Success"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="可推送"><Setter Property="Appearance" Value="Info"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="已提交，待推送"><Setter Property="Appearance" Value="Caution"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="已推送"><Setter Property="Appearance" Value="Success"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="操作失败"><Setter Property="Appearance" Value="Danger"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </ui:Badge.Style>
        </ui:Badge>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </ui:DataGrid>
    </Border>
    <GridSplitter Grid.Row="1" Height="14" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="调整项目列表和结果区高度">
     <GridSplitter.Template>
      <ControlTemplate TargetType="GridSplitter">
       <Grid Background="Transparent">
        <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Border Width="32" Height="9" Background="{DynamicResource ApplicationBackgroundBrush}" HorizontalAlignment="Center">
         <StackPanel VerticalAlignment="Center" Margin="4,0">
          <Border Height="1" Background="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2"/>
          <Border Height="1" Background="{DynamicResource TextFillColorTertiaryBrush}"/>
         </StackPanel>
        </Border>
       </Grid>
      </ControlTemplate>
     </GridSplitter.Template>
    </GridSplitter>
    <TabControl Grid.Row="2" x:Name="HomeResults" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
     <TabItem Header="变更清单" x:Name="HomeChangesTab">
      <DockPanel Margin="10,12,10,10" TextElement.FontWeight="Normal">
       <TextBlock x:Name="HomeChangesSummary" DockPanel.Dock="Top" Margin="12,0,0,12" Text="构建并预览后显示待同步变更。"/>
       <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
       <ui:DataGrid x:Name="HomeChanges" SizeChanged="DashboardTableSizeChanged" RowHeight="36" GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" ColumnHeaderHeight="36">
        <DataGrid.GroupStyle>
         <GroupStyle>
          <GroupStyle.HeaderTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Padding="8,4">
             <TextBlock.Style>
              <Style TargetType="TextBlock">
               <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="目标清理（永久删除）">
                 <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
           </DataTemplate>
          </GroupStyle.HeaderTemplate>
         </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.Columns>
         <DataGridTextColumn Header="项目" Width="1.15*" MinWidth="100" Binding="{Binding Project}"/>
         <DataGridTextColumn Header="操作" Width="0.6*" MinWidth="85" Binding="{Binding Action}"/>
         <DataGridTextColumn Header="路径" Width="2.75*" MinWidth="160" Binding="{Binding Path}"/>
        </DataGrid.Columns>
       </ui:DataGrid>
       </Border>
      </DockPanel>
     </TabItem>
     <TabItem Header="运行日志" x:Name="HomeLogTab">
      <ui:TextBox x:Name="HomeLog" FontSize="13" FontWeight="Normal" Margin="10" Padding="14,10" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="{DynamicResource ControlFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
     </TabItem>
    </TabControl>
   </Grid>
  </DockPanel>
  <DockPanel x:Name="ProjectPage" Visibility="Collapsed" Background="Transparent" TextElement.FontSize="14" TextElement.FontWeight="Normal">
  <Border DockPanel.Dock="Top" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="18,14,18,12">
   <StackPanel>
   <WrapPanel x:Name="Actions">
    <ui:Button Appearance="Secondary" Margin="0,0,8,0" Content="← 返回项目列表" Click="BackToHome"/>
    <ui:Button Appearance="Primary" Margin="0,0,8,0" Content="保存项目" Click="SaveProject"/>
    <ui:Button Appearance="Secondary" Content="导出 JSON" Click="Save" ToolTip="将当前表单导出成 JSON 文件"/>
   </WrapPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Style.Triggers>
       <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   </StackPanel>
  </Border>
   <TabControl x:Name="SettingsTabs" TabStripPlacement="Left" Template="{StaticResource SettingsTabsLayout}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <TabItem x:Name="RemoteSettingsTab" Header="Git 远端仓库">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
        <Label Padding="0,8,0,5" Target="{Binding ElementName=remote}" Content="Git 远端名称（如 origin）"/>
        <DockPanel>
         <ui:Button Appearance="Secondary" DockPanel.Dock="Right" Content="检测远端名称" Click="DetectRemotes" Margin="8,0,0,0"/>
         <ComboBox x:Name="remote" IsEditable="True" IsTextSearchEnabled="False"/>
        </DockPanel>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=remoteUrl}" Content="远端仓库地址（留空时使用远端名称）"/>
        <ui:TextBox x:Name="remoteUrl" ToolTip="git@github.com:账号/仓库.git 或 https://github.com/账号/仓库.git"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=githubUsername}" Content="GitHub 登录用户名（HTTPS，可选）"/>
        <ui:TextBox x:Name="githubUsername" ToolTip="填写此项目用来授权的账号，可以与仓库所有者不同。"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=branch}" Content="目标分支"/>
        <ComboBox x:Name="branch" IsEditable="True" IsTextSearchEnabled="False"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=gitSshCommand}" Content="SSH 命令与参数（可选）"/>
        <ui:TextBox x:Name="gitSshCommand"/>
        <ui:Button Appearance="Primary" HorizontalAlignment="Left" Margin="0,6,0,4" Content="测试远端连接" Click="TestRemote"/>

      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="LocalSettingsTab" Header="Git 本地仓库">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
       <Label Padding="0,8,0,5" Target="{Binding ElementName=ProjectName}" Content="项目名称"/>
       <ui:TextBox x:Name="ProjectName" Margin="0,0,0,10"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=windowsRepo}" Content="仓库路径"/>
        <DockPanel>
         <ui:Button Appearance="Secondary" DockPanel.Dock="Right" Content="初始化 Git…" Click="InitializeLocalGit" Margin="8,0,0,0"/>
         <ui:Button Appearance="Secondary" DockPanel.Dock="Right" Content="浏览…" Click="Browse" Margin="8,0,0,0"/>
         <ui:TextBox x:Name="windowsRepo"/>
        </DockPanel>
        <TextBlock x:Name="LocalGitStatus" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="本地构建环境">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
        <Label Padding="0,8,0,5" Target="{Binding ElementName=wslRepo}" Content="WSL 仓库路径"/>
        <DockPanel>
         <ui:Button Appearance="Secondary" DockPanel.Dock="Right" Content="检测环境" Click="DetectWsl" Margin="8,0,0,0"/>
         <ui:TextBox x:Name="wslRepo"/>
        </DockPanel>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=WslDistribution}" Content="WSL 发行版"/>
        <ComboBox x:Name="WslDistribution" SelectionChanged="ChooseWslDistribution"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=WslUserChoice}" Content="WSL 用户"/>
        <ComboBox x:Name="WslUserChoice" SelectionChanged="ChooseWslUser"/>
        <ui:TextBox x:Name="distro" Visibility="Collapsed"/>
        <ui:TextBox x:Name="wslUser" Visibility="Collapsed"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=pullPath}" Content="从远端拉入 WSL 的目录（每行一项）"/>
        <ui:TextBox x:Name="pullPath" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Visible"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=buildCommand}" Content="构建命令"/>
        <ui:TextBox x:Name="buildCommand"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=previewCommand}" Content="预览命令（可选）"/>
        <ui:TextBox x:Name="previewCommand" ToolTip="例如 pnpm docs:preview。请在命令输出中提供本地预览地址。"/>
        <ui:ToggleSwitch x:Name="PreviewAfterBuild" Margin="0,8,0,0" OnContent="构建成功后在浏览器打开预览" OffContent="构建成功后在浏览器打开预览" AutomationProperties.Name="构建成功后在浏览器打开预览"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=reinstallCommand}" Content="重装依赖命令（可选）"/>
        <ui:TextBox x:Name="reinstallCommand" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"
                 ToolTip="在项目的 WSL 根目录执行，每行可填写一条 shell 命令。"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=themeUpgradeCommand}" Content="升级主题命令（可选）"/>
        <ui:TextBox x:Name="themeUpgradeCommand" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"
                 ToolTip="例如 pnpm dlx vp-update。在 WSL 项目根目录执行。"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=NodeVersion}" Content="Node.js 版本"/>
        <ComboBox x:Name="NodeVersion" DisplayMemberPath="Label" SelectionChanged="ChooseNodeVersion"/>
        <TextBlock x:Name="NodeHint" TextWrapping="Wrap"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=nodeBin}" Content="额外 PATH 目录（可选）"/>
        <ui:TextBox x:Name="nodeBin"/>

      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="同步与清理">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
        <Label Padding="0,8,0,5" Target="{Binding ElementName=include}" Content="构建通过后同步的路径（每行一项）"/>
        <ui:TextBox x:Name="include" LostKeyboardFocus="NormalizeSyncPathField" AcceptsReturn="True" Height="208" VerticalScrollBarVisibility="Visible"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=exclude}" Content="排除路径（每行一项，可留空）"/>
        <ui:TextBox x:Name="exclude" LostKeyboardFocus="NormalizeSyncPathField" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=excludeSuffixes}" Content="排除文件名后缀（每行一项，可留空）"/>
        <ui:TextBox x:Name="excludeSuffixes" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"
                 ToolTip="填写文件名结尾，例如 Zone.Identifier 或 .map。"/>
        <ui:ToggleSwitch x:Name="CleanUntracked" Margin="0,16,0,0" OnContent="同步前永久清理整个目标仓库中未跟踪且未忽略的文件" OffContent="同步前永久清理整个目标仓库中未跟踪且未忽略的文件" AutomationProperties.Name="同步前永久清理整个目标仓库中未跟踪且未忽略的文件"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="快速配置（JSON）" x:Name="JsonSettingsTab">
     <DockPanel Margin="24,20,24,24">
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="JSON 配置" FontSize="16" Margin="0,0,0,12"/>
       <WrapPanel>
        <ui:Button Appearance="Secondary" Content="导入文件" Click="Open"/>
        <ui:Button Appearance="Primary" Content="应用 JSON" Click="ApplyJson"/>
       </WrapPanel>
       <TextBlock Text="粘贴或修改 JSON 后，点击「应用 JSON」更新项目设置。" TextWrapping="Wrap" Margin="0,4,0,8"/>
      </StackPanel>
      <ui:TextBox x:Name="Config" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
     </DockPanel>
    </TabItem>
   </TabControl>
 </DockPanel>
  </Grid>
 </DockPanel>
</ui:FluentWindow>

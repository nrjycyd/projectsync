<Window x:Class="ProjectSync.App.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ProjectSync" Width="1228" Height="816" MinWidth="780" MinHeight="530"
 Background="#FAFAFA" Foreground="#171A1D" UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI" Icon="/ProjectSync.App;component/Assets/ProjectSync.ico">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="CompactDesktopStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  <CornerRadius x:Key="ControlRadius">4</CornerRadius>
  <CornerRadius x:Key="PopupRadius">6</CornerRadius>
  <SolidColorBrush x:Key="FieldSurface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#171A1D"/>
  <SolidColorBrush x:Key="Line" Color="#CDD1D4"/>
  <SolidColorBrush x:Key="Accent" Color="#106849"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="MinHeight" Value="35"/>
   <Setter Property="Margin" Value="0,0,8,4"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#F1F3F3"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="Template" Value="{StaticResource CompactButtonTemplate}"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="White"/>
  </Style>
  <Thickness x:Key="FieldPadding">10,5</Thickness>
  <Thickness x:Key="ComboArrowSpace">0,0,26,0</Thickness>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
   <Setter Property="BorderBrush" Value="#A4ADB3"/>
   <Setter Property="Background" Value="{StaticResource FieldSurface}"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="InputBorder" CornerRadius="{StaticResource ControlRadius}" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <ScrollViewer x:Name="PART_ContentHost" Padding="0" Margin="0"
                     VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                     HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Geometry x:Key="DropDownChevron">M 0 0 L 4.5 4.5 L 9 0</Geometry>
  <Style x:Key="DropDownPopupBorder" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#A4ADB3"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="{StaticResource PopupRadius}"/>
   <Setter Property="Padding" Value="0,2"/>
   <Setter Property="Margin" Value="0,0,6,6"/>
   <Setter Property="Effect" Value="{StaticResource PopupShadow}"/>
  </Style>
  <Style x:Key="HomeDropDownMenu" TargetType="ContextMenu">
   <Setter Property="VerticalOffset" Value="2"/>
   <Setter Property="HasDropShadow" Value="False"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ContextMenu">
      <Border Style="{StaticResource DropDownPopupBorder}" MinWidth="112">
       <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="HomeDropDownItem" TargetType="MenuItem">
   <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="MenuItem">
      <Border x:Name="Option" Background="Transparent" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
       <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#EFF4FA"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#646C75"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="Background" Value="{StaticResource FieldSurface}"/>
   <Setter Property="BorderBrush" Value="#A4ADB3"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
               BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"/>
       <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                     IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Padding="0,0,9,0">
           <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="{StaticResource DropDownChevron}"
                 Stroke="#5E6662" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Border BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="{StaticResource ComboArrowSpace}">
        <Grid>
         <ContentPresenter x:Name="Selection" IsHitTestVisible="False" VerticalAlignment="Center"
                           Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                           ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
         <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                  Padding="0" VerticalContentAlignment="Center" Focusable="True"
                  IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed">
          <TextBox.Template>
           <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Padding="0" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
           </ControlTemplate>
          </TextBox.Template>
         </TextBox>
        </Grid>
       </Border>
       <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" VerticalOffset="2"
              IsOpen="{TemplateBinding IsDropDownOpen}">
        <Border Style="{StaticResource DropDownPopupBorder}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEditable" Value="True">
        <Setter TargetName="Selection" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Line}"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
       <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Option" Background="Transparent" CornerRadius="{StaticResource ControlRadius}" Padding="{TemplateBinding Padding}">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="#CCE1FA"/></Trigger>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#EFF4FA"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <ControlTemplate x:Key="SettingsLayout" TargetType="TabControl">
   <Grid KeyboardNavigation.TabNavigation="Local">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="196"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#EEF1F3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
     <TabPanel IsItemsHost="True" Margin="0,8,0,0"/>
    </Border>
    <Border Grid.Column="1" Background="White">
     <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
    </Border>
   </Grid>
  </ControlTemplate>
  <Style x:Key="NavigationTab" TargetType="TabItem">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="MinHeight" Value="46"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Margin="5,0,5,0">
       <Grid>
        <Border x:Name="NavMarker" Width="4" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2"/>
        <ContentPresenter Margin="17,0,10,0" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E5EBE9"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#D8E9E0"/><Setter TargetName="NavMarker" Property="Background" Value="{StaticResource Accent}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#EEF1EE"/>
   <Setter Property="Foreground" Value="#424B46"/>
   <Setter Property="Padding" Value="8,7"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="RepoCellText" TargetType="TextBlock">
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="5,0"/>
   <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <Style x:Key="ResultTab" TargetType="TabItem">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Margin="0,0,5,0" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="2">
       <Grid>
        <ContentPresenter Margin="13,6" ContentSource="Header" RecognizesAccessKey="True"/>
        <Border x:Name="TabIndicator" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#F0F3F1"/></Trigger>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabIndicator" Property="Background" Value="{StaticResource Accent}"/>
        <Setter TargetName="TabSurface" Property="Background" Value="#EAF5EC"/>
        <Setter Property="Foreground" Value="#08743B"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Padding" Value="5,0"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF5EC"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#8EAA9C"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="DashboardTable" TargetType="DataGrid">
   <Setter Property="Background" Value="White"/>
   <Setter Property="RowBackground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowHeight" Value="36"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="GridLinesVisibility" Value="All"/>
   <Setter Property="VerticalGridLinesBrush" Value="{StaticResource TableGridLine}"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TableGridLine}"/>
  </Style>
  <ControlTemplate x:Key="DashboardResults" TargetType="TabControl">
   <Border Background="White" BorderBrush="#AEB6BF" BorderThickness="1" CornerRadius="5">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F7F8F9" CornerRadius="4,4,0,0" BorderBrush="#D5DADE" BorderThickness="0,0,0,1" Padding="9,6">
      <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
     </Border>
     <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
    </DockPanel>
   </Border>
  </ControlTemplate>
  <Style x:Key="TableSurface" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#AEB6BF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="5"/>
   <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="ProjectCheckStyle" TargetType="CheckBox">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" Background="White" BorderBrush="#89958F" BorderThickness="1">
       <Path x:Name="Tick" Data="M 0,4 L 3,7 L 9,0" Stroke="White" StrokeThickness="1.7"
             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="DashboardCellText" TargetType="TextBlock" BasedOn="{StaticResource RepoCellText}">
   <Setter Property="Margin" Value="14,0,4,0"/>
  </Style>
  <Style x:Key="DashboardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="BorderBrush" Value="#A6ADB3"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Opacity" Value="1"/>
     <Setter Property="Background" Value="#F1F2F3"/>
     <Setter Property="BorderBrush" Value="#DFE2E5"/>
     <Setter Property="Foreground" Value="#646C75"/>
    </Trigger>
    <DataTrigger Binding="{Binding Tag, ElementName=HomePage}" Value="True">
     <Setter Property="Opacity" Value="1"/>
     <Setter Property="Background" Value="#F1F3F3"/>
     <Setter Property="BorderBrush" Value="#A6ADB3"/>
     <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="RepositoryShortcut" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="1,0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template" Value="{StaticResource CompactButtonTemplate}"/>
  </Style>
  <DataTemplate x:Key="ToolbarIconLabel">
   <StackPanel Orientation="Horizontal">
    <Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
          Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
          Margin="0,0,7,0" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="DashboardPrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
   <Setter Property="Background" Value="#08743B"/>
   <Setter Property="BorderBrush" Value="#08743B"/>
   <Setter Property="Foreground" Value="White"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Tag, ElementName=HomePage}" Value="True">
     <Setter Property="Background" Value="#08743B"/>
     <Setter Property="BorderBrush" Value="#08743B"/>
     <Setter Property="Foreground" Value="White"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="DashboardHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
   <Setter Property="Background" Value="{StaticResource TableHeaderSurface}"/>
   <Setter Property="Foreground" Value="#20252A"/>
   <Setter Property="Padding" Value="14,0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="BorderBrush" Value="#D5DADE"/>
  </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <DockPanel x:Name="HomePage" Margin="26,20,26,16" Background="#FAFAFA" TextElement.FontSize="15">
   <Grid DockPanel.Dock="Top" Margin="0,0,0,12" SizeChanged="HomeToolbarSizeChanged">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel x:Name="BatchActions" Orientation="Horizontal" HorizontalAlignment="Left">
     <Button MinHeight="34" Padding="16,5" x:Name="PreviewBatchButton" Style="{StaticResource DashboardPrimaryButton}" MinWidth="122" Content="构建并预览" ContentTemplate="{StaticResource ToolbarIconLabel}" Tag="M2,1 L13,7 L2,13 Z" Click="PreviewSelected" IsEnabled="False"/>
     <Button Style="{StaticResource DashboardButton}" MinHeight="34" Padding="16,5" x:Name="ApplyBatchButton" MinWidth="99" Content="应用同步" ContentTemplate="{StaticResource ToolbarIconLabel}" Tag="M12,5 A5,5 0 1 0 12,10 M12,1 V5 H8" Click="ApplySelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="对预览成功且已勾选的项目应用同步"/>
     <Button Style="{StaticResource DashboardPrimaryButton}" MinHeight="34" Padding="16,5" x:Name="PublishBatchButton" MinWidth="112" Content="提交并推送" ContentTemplate="{StaticResource ToolbarIconLabel}" Tag="M7,11 V1 M3,5 L7,1 L11,5 M1,13 H13" Click="PublishSelected" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="提交并推送已应用同步且已勾选的项目"/>
     <TextBlock x:Name="SelectionSummary" Margin="10,0,0,4" VerticalAlignment="Center" Foreground="#20252A"/>
    </StackPanel>
     <StackPanel x:Name="HomeActions" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
      <StackPanel x:Name="NewProjectGroup" Orientation="Horizontal" Margin="0,0,10,4">
       <Button Style="{StaticResource DashboardButton}" MinHeight="34" Padding="13,5" Margin="0" Content="新建项目" Click="NewProject"/>
       <Button Style="{StaticResource DashboardButton}" MinHeight="34" Padding="9,5" Margin="-1,0,0,0"
               AutomationProperties.Name="更多项目操作" ToolTip="更多项目操作" Click="OpenHomeMenu">
        <Path Data="{StaticResource DropDownChevron}" Stroke="#5E6662" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
        <Button.ContextMenu>
         <ContextMenu Style="{StaticResource HomeDropDownMenu}">
          <MenuItem Style="{StaticResource HomeDropDownItem}" Header="导入 JSON" Click="ImportProject"/>
          <MenuItem Style="{StaticResource HomeDropDownItem}" x:Name="RemoveProjectItem" Header="移除" Click="RemoveProject" IsEnabled="False"/>
         </ContextMenu>
        </Button.ContextMenu>
       </Button>
      </StackPanel>
      <Button Style="{StaticResource DashboardButton}" MinHeight="34" Padding="12,5" MinWidth="108"
              AutomationProperties.Name="工具" Click="OpenHomeMenu">
       <StackPanel Orientation="Horizontal"><TextBlock Text="工具" Margin="0,0,8,0"/><Path Data="{StaticResource DropDownChevron}" Stroke="#5E6662" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/></StackPanel>
       <Button.ContextMenu>
        <ContextMenu Style="{StaticResource HomeDropDownMenu}">
         <MenuItem Style="{StaticResource HomeDropDownItem}" Header="文件复制" Click="OpenFileCopy"/>
         <MenuItem Style="{StaticResource HomeDropDownItem}" Header="WSL 环境" Click="OpenWslManager"/>
        </ContextMenu>
       </Button.ContextMenu>
      </Button>
     </StackPanel>
   </Grid>
   <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="0,1,0,0" MinHeight="20">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="AppVersionText" FontSize="13" Foreground="#535F58" VerticalAlignment="Center" Margin="0,0,9,0"/>
      <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="CheckUpdates" Style="{StaticResource DashboardButton}" MinHeight="25" Padding="9,2"
              Margin="0" FontSize="13"/>
     </StackPanel>
     <TextBlock x:Name="HomeStatus" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#3F4750"/>
    </DockPanel>
   </Border>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="38*" MinHeight="104"/>
     <RowDefinition Height="28"/>
     <RowDefinition Height="62*" MinHeight="120"/>
    </Grid.RowDefinitions>
    <Border Style="{StaticResource TableSurface}">
    <DataGrid x:Name="Projects" SizeChanged="DashboardTableSizeChanged" Style="{StaticResource DashboardTable}" ColumnHeaderStyle="{StaticResource DashboardHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" SelectionMode="Single" ColumnHeaderHeight="36"

              SelectionChanged="ProjectSelectionChanged">
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <EventSetter Event="MouseDoubleClick" Handler="OpenProjectRow"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Checked}" Value="True"><Setter Property="Background" Value="#EAF5EC"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="勾选" Width="66" CanUserSort="False">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox Style="{StaticResource ProjectCheckStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Click="ProjectCheckChanged" AutomationProperties.Name="{Binding Name}"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="项目名称" Width="1.5*" MinWidth="115" Binding="{Binding Name}" ElementStyle="{StaticResource DashboardCellText}"/>
      <DataGridTextColumn Header="Git 远端仓库" Width="2.65*" MinWidth="150" Binding="{Binding RemoteRepository}" ElementStyle="{StaticResource DashboardCellText}"/>
      <DataGridTextColumn Header="Git 本地仓库" Width="2.8*" MinWidth="170" Binding="{Binding Repository}" ElementStyle="{StaticResource DashboardCellText}"/>
      <DataGridTemplateColumn Header="快捷访问" Width="198" CanUserSort="False">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Button Style="{StaticResource RepositoryShortcut}" Tag="Local" Click="OpenRepositoryShortcut"
                 ToolTip="打开 Git 本地仓库" AutomationProperties.Name="打开 Git 本地仓库">
          <Path Data="M1,4 L7,4 L9,6 L17,6 L17,15 L1,15 Z" Stroke="{StaticResource Ink}" StrokeThickness="1.4"/>
         </Button>
         <Button Style="{StaticResource RepositoryShortcut}" Tag="Wsl" Click="OpenRepositoryShortcut"
                 ToolTip="打开本地构建环境" AutomationProperties.Name="打开本地构建环境">
          <Path Data="M1,4 L7,4 L9,6 L17,6 L17,15 L1,15 Z M6,10 H12 M6,12 H12" Stroke="{StaticResource Ink}" StrokeThickness="1.4"/>
         </Button>
         <Button Style="{StaticResource RepositoryShortcut}" Tag="WslTerminal" Click="OpenRepositoryShortcut"
                 ToolTip="在终端打开 WSL 项目目录" AutomationProperties.Name="在终端打开 WSL 项目目录">
          <Path Data="M1,2 H17 V15 H1 Z M1,5 H17 M4,7 L7,10 L4,13 M9,13 H14" Stroke="{StaticResource Ink}" StrokeThickness="1.4"/>
         </Button>
         <Button Style="{StaticResource RepositoryShortcut}" Tag="Remote" Click="OpenRepositoryShortcut"
                 ToolTip="打开 Git 远端仓库" AutomationProperties.Name="打开 Git 远端仓库">
          <Path Data="M14,9 V16 H1 V3 H8 M10,1 H17 V8 M17,1 L8,10" Stroke="{StaticResource Ink}" StrokeThickness="1.4"/>
         </Button>
         <Button Style="{StaticResource RepositoryShortcut}" Tag="Reinstall" Click="OpenRepositoryShortcut"
                 ToolTip="重装依赖" AutomationProperties.Name="重装依赖">
          <Path Data="M1,5 L8,1 L15,5 L8,9 Z M1,5 V13 L8,17 M8,9 V17 M15,5 V8 M17,11 A4,4 0 1 0 17,16 M17,8 V12 H13"
                Stroke="{StaticResource Ink}" StrokeThickness="1.4"/>
         </Button>
         <Button Style="{StaticResource RepositoryShortcut}" Tag="UpgradeTheme" Click="OpenRepositoryShortcut"
                 ToolTip="升级主题" AutomationProperties.Name="升级主题">
          <Path Data="M2,16 C2,13 5,11 8,12 C9,15 6,17 2,16 Z M7,12 L13,3 Q15,1 16,3 L10,13 M12,10 L15,7 L18,10 M15,7 V15"
                Stroke="{StaticResource Ink}" StrokeThickness="1.4"/>
         </Button>
        </StackPanel>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="进度" Width="1.45*" MinWidth="110" SortMemberPath="Progress">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="{StaticResource ControlRadius}" Padding="9,3" Margin="14,0,0,0">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="#EDF1F5"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Progress}" Value="可同步"><Setter Property="Background" Value="#DCEFE0"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="可推送"><Setter Property="Background" Value="#E4F3ED"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="推送步骤完成"><Setter Property="Background" Value="#E4F3ED"/></DataTrigger>
            <DataTrigger Binding="{Binding Progress}" Value="操作失败"><Setter Property="Background" Value="#FCE8E8"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <TextBlock Text="{Binding Progress}">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Progress}" Value="可同步"><Setter Property="Foreground" Value="#135C2D"/></DataTrigger>
             <DataTrigger Binding="{Binding Progress}" Value="可推送"><Setter Property="Foreground" Value="#135C2D"/></DataTrigger>
             <DataTrigger Binding="{Binding Progress}" Value="操作失败"><Setter Property="Foreground" Value="#982B2B"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </Border>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    </Border>
    <GridSplitter Grid.Row="1" Height="14" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  AutomationProperties.Name="调整项目列表和结果区高度">
     <GridSplitter.Template>
      <ControlTemplate TargetType="GridSplitter">
       <Grid Background="Transparent">
        <Border Height="1" VerticalAlignment="Center" Background="#CDD3CF"/>
        <Border Width="32" Height="9" Background="#FAFAFA" HorizontalAlignment="Center">
         <StackPanel VerticalAlignment="Center" Margin="4,0">
          <Border Height="1" Background="#A9B2AD" Margin="0,0,0,2"/>
          <Border Height="1" Background="#A9B2AD"/>
         </StackPanel>
        </Border>
       </Grid>
      </ControlTemplate>
     </GridSplitter.Template>
    </GridSplitter>
    <TabControl Grid.Row="2" x:Name="HomeResults" Template="{StaticResource DashboardResults}" ItemContainerStyle="{StaticResource ResultTab}" Background="White" BorderBrush="{StaticResource Line}">
     <TabItem Header="变更清单" x:Name="HomeChangesTab">
      <DockPanel Margin="10,12,10,10" TextElement.FontWeight="Normal">
       <TextBlock x:Name="HomeChangesSummary" DockPanel.Dock="Top" Margin="12,0,0,12" Text="构建并预览后显示待同步变更。"/>
       <Border Style="{StaticResource TableSurface}">
       <DataGrid x:Name="HomeChanges" SizeChanged="DashboardTableSizeChanged" Style="{StaticResource DashboardTable}" ColumnHeaderStyle="{StaticResource DashboardHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" ColumnHeaderHeight="36">
        <DataGrid.Columns>
         <DataGridTextColumn Header="项目" Width="1.15*" MinWidth="100" Binding="{Binding Project}" ElementStyle="{StaticResource DashboardCellText}"/>
         <DataGridTextColumn Header="操作" Width="0.6*" MinWidth="85" Binding="{Binding Action}" ElementStyle="{StaticResource DashboardCellText}"/>
         <DataGridTextColumn Header="路径" Width="2.75*" MinWidth="160" Binding="{Binding Path}" ElementStyle="{StaticResource DashboardCellText}"/>
        </DataGrid.Columns>
       </DataGrid>
       </Border>
      </DockPanel>
     </TabItem>
     <TabItem Header="运行日志" x:Name="HomeLogTab">
      <TextBox x:Name="HomeLog" FontSize="13" FontWeight="Normal" Margin="10" Padding="14,10" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#272F38" Foreground="#F0F4F5"/>
     </TabItem>
    </TabControl>
   </Grid>
  </DockPanel>
  <DockPanel x:Name="ProjectPage" Visibility="Collapsed" Background="White" TextElement.FontSize="14" TextElement.FontWeight="Normal">
  <Border DockPanel.Dock="Top" Background="#F3F5F7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,14,18,12">
   <StackPanel>
   <WrapPanel x:Name="Actions">
    <Button Content="← 返回项目列表" Click="BackToHome"/>
    <Button Content="保存项目" Click="SaveProject" Style="{StaticResource PrimaryButton}"/>
    <Button Content="导出 JSON" Click="Save" ToolTip="将当前表单导出成 JSON 文件"/>
   </WrapPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="#475569">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Style.Triggers>
       <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   </StackPanel>
  </Border>
   <TabControl x:Name="SettingsTabs" Template="{StaticResource SettingsLayout}" ItemContainerStyle="{StaticResource NavigationTab}" TabStripPlacement="Left" BorderBrush="{StaticResource Line}" Background="White">
    <TabItem x:Name="RemoteSettingsTab" Header="Git 远端仓库">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
        <Label Padding="0,8,0,5" Target="{Binding ElementName=remote}" Content="Git 远端名称（如 origin）"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="检测远端名称" Click="DetectRemotes" Margin="8,0,0,0"/>
         <ComboBox x:Name="remote" IsEditable="True" IsTextSearchEnabled="False"/>
        </DockPanel>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=remoteUrl}" Content="远端仓库地址（留空时使用远端名称）"/>
        <TextBox x:Name="remoteUrl" ToolTip="git@github.com:账号/仓库.git 或 https://github.com/账号/仓库.git"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=githubUsername}" Content="GitHub 登录用户名（HTTPS，可选）"/>
        <TextBox x:Name="githubUsername" ToolTip="填写此项目用来授权的账号，可以与仓库所有者不同。"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=branch}" Content="目标分支"/>
        <ComboBox x:Name="branch" IsEditable="True" IsTextSearchEnabled="False"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=gitSshCommand}" Content="SSH 命令与参数（可选）"/>
        <TextBox x:Name="gitSshCommand"/>
        <Button HorizontalAlignment="Left" Margin="0,6,0,4" Content="测试远端连接" Click="TestRemote" Style="{StaticResource PrimaryButton}"/>

      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem x:Name="LocalSettingsTab" Header="Git 本地仓库">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
       <Label Padding="0,8,0,5" Target="{Binding ElementName=ProjectName}" Content="项目名称"/>
       <TextBox x:Name="ProjectName" Margin="0,0,0,10"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=windowsRepo}" Content="仓库路径"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="初始化 Git…" Click="InitializeLocalGit" Margin="8,0,0,0"/>
         <Button DockPanel.Dock="Right" Content="浏览…" Click="Browse" Margin="8,0,0,0"/>
         <TextBox x:Name="windowsRepo"/>
        </DockPanel>
        <TextBlock x:Name="LocalGitStatus" Margin="0,8,0,0" Foreground="#475569" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="本地构建环境">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
        <Label Padding="0,8,0,5" Target="{Binding ElementName=wslRepo}" Content="WSL 仓库路径"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="检测环境" Click="DetectWsl" Margin="8,0,0,0"/>
         <TextBox x:Name="wslRepo"/>
        </DockPanel>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=WslDistribution}" Content="WSL 发行版"/>
        <ComboBox x:Name="WslDistribution" SelectionChanged="ChooseWslDistribution"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=WslUserChoice}" Content="WSL 用户"/>
        <ComboBox x:Name="WslUserChoice" SelectionChanged="ChooseWslUser"/>
        <TextBox x:Name="distro" Visibility="Collapsed"/>
        <TextBox x:Name="wslUser" Visibility="Collapsed"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=pullPath}" Content="从远端拉入 WSL 的目录（每行一项）"/>
        <TextBox x:Name="pullPath" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Visible"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=buildCommand}" Content="构建命令"/>
        <TextBox x:Name="buildCommand"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=previewCommand}" Content="预览命令（可选）"/>
        <TextBox x:Name="previewCommand" ToolTip="例如 pnpm docs:preview。请在命令输出中提供本地预览地址。"/>
        <CheckBox x:Name="PreviewAfterBuild" Margin="0,8,0,0" Content="构建成功后在浏览器打开预览"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=reinstallCommand}" Content="重装依赖命令（可选）"/>
        <TextBox x:Name="reinstallCommand" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"
                 ToolTip="在项目的 WSL 根目录执行，每行可填写一条 shell 命令。"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=themeUpgradeCommand}" Content="升级主题命令（可选）"/>
        <TextBox x:Name="themeUpgradeCommand" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"
                 ToolTip="例如 pnpm dlx vp-update。在 WSL 项目根目录执行。"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=NodeVersion}" Content="Node.js 版本"/>
        <ComboBox x:Name="NodeVersion" DisplayMemberPath="Label" SelectionChanged="ChooseNodeVersion"/>
        <TextBlock x:Name="NodeHint" TextWrapping="Wrap"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=nodeBin}" Content="额外 PATH 目录（可选）"/>
        <TextBox x:Name="nodeBin"/>

      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="同步与清理">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,14,24,24">
        <Label Padding="0,8,0,5" Target="{Binding ElementName=include}" Content="构建通过后同步的路径（每行一项）"/>
        <TextBox x:Name="include" LostKeyboardFocus="NormalizeSyncPathField" AcceptsReturn="True" Height="208" VerticalScrollBarVisibility="Visible"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=exclude}" Content="排除路径（每行一项，可留空）"/>
        <TextBox x:Name="exclude" LostKeyboardFocus="NormalizeSyncPathField" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"/>
        <Label Padding="0,8,0,5" Target="{Binding ElementName=excludeSuffixes}" Content="排除文件名后缀（每行一项，可留空）"/>
        <TextBox x:Name="excludeSuffixes" AcceptsReturn="True" Height="98" VerticalScrollBarVisibility="Visible"
                 ToolTip="填写文件名结尾，例如 Zone.Identifier 或 .map。"/>
        <CheckBox x:Name="CleanUntracked" Margin="0,16,0,0" Content="同步前清理目标仓库中未跟踪且未忽略的文件"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="快速配置（JSON）" x:Name="JsonSettingsTab">
     <DockPanel Margin="24,20,24,24">
      <StackPanel DockPanel.Dock="Top">
       <TextBlock Text="JSON 配置" FontSize="16" Margin="0,0,0,12"/>
       <WrapPanel>
        <Button Content="导入文件" Click="Open"/>
        <Button Content="应用 JSON" Click="ApplyJson" Style="{StaticResource PrimaryButton}"/>
       </WrapPanel>
       <TextBlock Text="粘贴或修改 JSON 后，点击「应用 JSON」更新项目设置。" TextWrapping="Wrap" Margin="0,4,0,8"/>
      </StackPanel>
      <TextBox x:Name="Config" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"/>
     </DockPanel>
    </TabItem>
   </TabControl>
 </DockPanel>
 </Grid>
</Window>

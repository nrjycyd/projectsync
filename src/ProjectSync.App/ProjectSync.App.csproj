<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.2</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/ProjectSync.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ProjectSync.ico" />
    <ProjectReference Include="../ProjectSync.Core/ProjectSync.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(PkgWPF-UI)/LICENSE.md" Link="licenses/WPF-UI-LICENSE.md"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgWPF-UI)/ThirdPartyNotices.txt" Link="licenses/WPF-UI-ThirdPartyNotices.txt"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ProjectSync.Core/Scripts/BuildSync.ps1" Link="scripts/BuildSync.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" GeneratePathProperty="true" />
  </ItemGroup>
</Project>

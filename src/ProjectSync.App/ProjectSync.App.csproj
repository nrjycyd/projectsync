<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.1</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/ProjectSync.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ProjectSync.ico" />
    <ProjectReference Include="../ProjectSync.Core/ProjectSync.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../ProjectSync.Core/Scripts/BuildSync.ps1" Link="BuildSync.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../examples/edusprout.build-sync.json" Link="edusprout.build-sync.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
